<!-- === INFINI TOWER SERIOUS UI PATCH === -->
<script>
(function(){
  function ready(fn){
    if(document.readyState !== "loading"){ fn(); }
    else{ document.addEventListener("DOMContentLoaded", fn); }
  }

  ready(function(){
    if(location.pathname !== "/tower") return;

    var cards = Array.from(document.querySelectorAll("a.card"));
    if(!cards.length) return;

    var firstCard = cards[0];

    if(!document.querySelector(".tower-serious-stats")){
      var stats = document.createElement("div");
      stats.className = "tower-serious-stats";
      stats.innerHTML = `
        <div class="tower-stat-box">
          <div class="tower-stat-label">MY POINT</div>
          <div class="tower-stat-value">12,450 INF</div>
          <div class="tower-stat-sub">พร้อมใช้ในระบบ</div>
        </div>
        <div class="tower-stat-box">
          <div class="tower-stat-label">CAMPAIGN</div>
          <div class="tower-stat-value">6 ACTIVE</div>
          <div class="tower-stat-sub">แคมเปญเปิดอยู่</div>
        </div>
        <div class="tower-stat-box">
          <div class="tower-stat-label">REWARD</div>
          <div class="tower-stat-value">120+</div>
          <div class="tower-stat-sub">ของรางวัล/การ์ด</div>
        </div>
        <div class="tower-stat-box">
          <div class="tower-stat-label">PARTNER</div>
          <div class="tower-stat-value">28 SHOP</div>
          <div class="tower-stat-sub">ร้านค้าพาร์ทเนอร์</div>
        </div>
      `;
      firstCard.parentNode.insertBefore(stats, firstCard);
    }

    if(!document.querySelector(".tower-system-note")){
      var note = document.createElement("div");
      note.className = "tower-system-note";
      note.innerHTML = "<b>INFINI POINT TOWER</b><br>ระบบสะสมแต้ม ดูแคมเปญ รับการ์ด แลกของรางวัล และใช้สิทธิ์กับร้านค้าพาร์ทเนอร์ภายใต้เงื่อนไขของระบบ";
      firstCard.parentNode.insertBefore(note, firstCard);
    }

    function enhanceCard(keyword, cls, chips, items, cta){
      var card = cards.find(function(c){
        return (c.innerText || "").toUpperCase().includes(keyword);
      });
      if(!card || card.dataset.towerEnhanced === "1") return;

      card.dataset.towerEnhanced = "1";
      card.classList.add("tower-action-card", cls);

      var ul = document.createElement("ul");
      ul.className = "tower-card-list";
      ul.innerHTML = items.map(function(x){ return "<li>" + x + "</li>"; }).join("");

      var chipBox = document.createElement("div");
      chipBox.className = "tower-card-chips";
      chipBox.innerHTML = chips.map(function(x){ return '<span class="tower-chip">' + x + '</span>'; }).join("");

      var btn = document.createElement("div");
      btn.className = "tower-card-cta";
      btn.textContent = cta;

      card.appendChild(ul);
      card.appendChild(chipBox);
      card.appendChild(btn);
    }

    enhanceCard(
      "ENTER TOWER",
      "tower-enter",
      ["MEMBER ACCESS", "DASHBOARD", "WALLET"],
      ["ดูยอดแต้มและสถานะ", "เข้าแคมเปญ/กระเป๋า", "จัดการกิจกรรมในตึก"],
      "เข้าสู่ตึก"
    );

    enhanceCard(
      "HOW TO EARN",
      "tower-earn",
      ["AD MARKET", "MISSION", "EARN INF"],
      ["เลือกหมวดโฆษณาที่สนใจ", "ดูครบเวลาเพื่อรับแต้ม", "ทำกิจกรรมเพื่อปลดล็อกการ์ด"],
      "เริ่มรับแต้ม"
    );

    enhanceCard(
      "REDEEM REWARDS",
      "tower-reward",
      ["REWARD CARD", "PARTNER SHOP", "REDEEM"],
      ["แลกของใช้ประจำวัน", "แลกของพรีเมียม/ลิมิเต็ด", "ถือการ์ดไว้ใช้ภายหลังได้"],
      "ดูของรางวัล"
    );
  });
})();
</script>
<!-- === END INFINI TOWER SERIOUS UI PATCH === -->

</body>
    </html>
    """)

