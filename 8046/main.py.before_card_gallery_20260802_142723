@app.post("/tower/cards/issue")
def tower_card_issue_submit(
    campaign_name: str = _CardForm(...),
    card_name: str = _CardForm(...),
    value_inf: int = _CardForm(...),
    quantity: int = _CardForm(...),
):
    campaign_name = (campaign_name or "").strip()[:100]
    card_name = (card_name or "").strip()[:100]
    if not campaign_name or not card_name:
        return _card_shell("ข้อมูลไม่ครบ", '<div class="panel resultBad"><h1>ข้อมูลไม่ครบ</h1><a class="btn" href="/tower/cards/issue">กลับ</a></div>')
    if value_inf < 1 or value_inf > 100000 or quantity < 1 or quantity > 100:
        return _card_shell("ข้อมูลไม่ถูกต้อง", '<div class="panel resultBad"><h1>จำนวนหรือมูลค่าไม่ถูกต้อง</h1><a class="btn" href="/tower/cards/issue">กลับ</a></div>')

    total = value_inf * quantity
    data = _card_load_state()
    wallet = data["wallet"]
    if total > int(wallet.get("available_inf", 0)):
        body = f'<div class="panel resultBad"><h1>INF ไม่พอ</h1><p>ต้องใช้ {total:,} INF</p><a class="btn" href="/tower/cards/issue">กลับ</a></div>'
        return _card_shell("INF ไม่พอ", body)

    campaign_id = "CMP-" + _card_secrets.token_hex(6).upper()
    created = _card_now_iso()
    data["campaigns"].append({
        "id": campaign_id,
        "name": campaign_name,
        "card_name": card_name,
        "value_inf": value_inf,
        "quantity": quantity,
        "created_at": created,
    })

    start_index = len(data["copies"]) + 1
    stamp = int(_card_time.time()) % 100000000
    for offset in range(quantity):
        token = _card_secrets.token_urlsafe(24)
        serial = f"INF-{stamp:08d}-{start_index + offset:04d}"
        data["copies"].append({
            "token": token,
            "serial": serial,
            "campaign_id": campaign_id,
            "campaign_name": campaign_name,
            "card_name": card_name,
            "value_inf": value_inf,
            "status": "active",
            "created_at": created,
            "redeemed_at": "",
        })

    wallet["available_inf"] -= total
    wallet["reserved_inf"] += total
    _card_save_state(data)
    return _CardRedirectResponse(f"/tower/cards/issued/{campaign_id}", status_code=303)


