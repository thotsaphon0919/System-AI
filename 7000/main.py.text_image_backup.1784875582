from fastapi import FastAPI, UploadFile, File, HTTPException
from fastapi.responses import HTMLResponse, JSONResponse
from fastapi.staticfiles import StaticFiles
from pydantic import BaseModel
from pathlib import Path
from typing import Optional, List
import json, shutil, uuid, time, re, mimetypes

APP_NAME = "INFINI Remote PRO V1"
BASE = Path(__file__).resolve().parent
DATA = BASE / "data"
UPLOADS = BASE / "uploads"
STATE = DATA / "remote_state.json"

DATA.mkdir(parents=True, exist_ok=True)
UPLOADS.mkdir(parents=True, exist_ok=True)

app = FastAPI(title=APP_NAME)
app.mount("/uploads", StaticFiles(directory=str(UPLOADS)), name="uploads")


def now():
    return int(time.time())


def uid(prefix: str):
    return f"{prefix}_{uuid.uuid4().hex[:10]}"


def clean_name(name: str):
    name = name or "upload.bin"
    name = re.sub(r"[^a-zA-Z0-9._-]+", "-", name)
    return name[:90] or "upload.bin"


def media_type(filename: str, content_type: str = ""):
    ct = (content_type or mimetypes.guess_type(filename)[0] or "").lower()
    return "video" if ct.startswith("video/") else "image"


def dump_model(m):
    if hasattr(m, "model_dump"):
        return m.model_dump(exclude_unset=True)
    return m.dict(exclude_unset=True)


DEFAULT_LINKS = {
    "creative": "/creative",
    "space": "/space",
    "zone": "/zone",
    "upload": "/upload-room",
    "link": "/link-room",
    "setting": "/setting-room",
}


def default_children():
    return [
        {
            "id": uid("child"),
            "title": f"ย่อย {i}",
            "subtitle": "กด ⚙ เพื่อตั้งค่า",
            "kind": "subslot",
            "media_url": "",
            "media_type": "",
            "link_url": "",
            "enabled": True,
            "created_at": now(),
            "updated_at": now(),
        }
        for i in range(1, 6)
    ]


def new_page(title="หน้าใหม่", subtitle="ปัดลงเพื่อดูช่องย่อย 5 ช่อง", media_url="", media_type=""):
    return {
        "id": uid("slot"),
        "title": title,
        "subtitle": subtitle,
        "kind": "page",
        "media_url": media_url,
        "media_type": media_type,
        "link_url": "",
        "enabled": True,
        "children": default_children(),
        "created_at": now(),
        "updated_at": now(),
    }


def default_state():
    defs = [
        ("Creative", "สร้าง/เปิดแผ่นงาน", "creative"),
        ("Space", "หน้าสาธารณะ", "space"),
        ("Zone", "โซน / ห้อง / ร้าน", "zone"),
        ("Upload", "รูป / วิดีโอ", "upload"),
        ("Link", "เชื่อมหน้า / เว็บ", "link"),
        ("Setting", "ตั้งค่า Slot", "setting"),
    ]
    slots = []
    for title, sub, kind in defs:
        slots.append({
            "id": uid("slot"),
            "title": title,
            "subtitle": sub,
            "kind": kind,
            "media_url": "",
            "media_type": "",
            "link_url": DEFAULT_LINKS.get(kind, ""),
            "enabled": True,
            "children": default_children(),
            "created_at": now(),
            "updated_at": now(),
        })
    return {
        "app": APP_NAME,
        "settings": {"active_sheet": "home", "theme": "orange-black", "port": 7000},
        "sheets": [{
            "id": "home",
            "title": "INFINI REMOTE PRO",
            "description": "หน้าแรกคือประตูเข้าแผ่น / กดแผ่น = เข้าห้องใหญ่",
            "order": 0,
            "created_at": now(),
            "updated_at": now(),
            "slots": slots,
        }],
    }


def save_state(st):
    tmp = STATE.with_suffix(".tmp")
    with tmp.open("w", encoding="utf-8") as f:
        json.dump(st, f, ensure_ascii=False, indent=2)
    tmp.replace(STATE)
    return st


def ensure_child(ch, idx=1):
    ch.setdefault("id", uid("child"))
    ch.setdefault("title", f"ย่อย {idx}")
    ch.setdefault("subtitle", "กด ⚙ เพื่อตั้งค่า")
    ch.setdefault("kind", "subslot")
    ch.setdefault("media_url", "")
    ch.setdefault("media_type", "")
    ch.setdefault("link_url", "")
    ch.setdefault("enabled", True)
    ch.setdefault("created_at", now())
    ch.setdefault("updated_at", now())
    return ch


def ensure_slot(sl):
    sl.setdefault("id", uid("slot"))
    sl.setdefault("title", "Slot")
    sl.setdefault("subtitle", "แตะใช้งาน / กด ⚙ ตั้งค่า")
    sl.setdefault("kind", "action")
    sl.setdefault("media_url", "")
    sl.setdefault("media_type", "")
    sl.setdefault("link_url", "")
    sl.setdefault("enabled", True)
    sl.setdefault("created_at", now())
    sl.setdefault("updated_at", now())
    k = str(sl.get("kind", "")).lower()
    if not sl.get("link_url") and k in DEFAULT_LINKS:
        sl["link_url"] = DEFAULT_LINKS[k]
    children = sl.get("children")
    if not isinstance(children, list):
        children = []
    while len(children) < 5:
        children.append(default_children()[len(children)])
    sl["children"] = [ensure_child(ch, i + 1) for i, ch in enumerate(children[:5])]
    return sl


def load_state():
    if not STATE.exists():
        return save_state(default_state())
    try:
        with STATE.open("r", encoding="utf-8") as f:
            st = json.load(f)
    except Exception:
        broken = STATE.with_suffix(f".broken.{now()}.json")
        try:
            shutil.move(str(STATE), str(broken))
        except Exception:
            pass
        st = default_state()

    st.setdefault("app", APP_NAME)
    st.setdefault("settings", {})
    st["settings"].setdefault("active_sheet", "home")
    st["settings"].setdefault("port", 7000)
    st.setdefault("sheets", [])
    if not st["sheets"]:
        st = default_state()

    for i, sh in enumerate(st["sheets"]):
        sh.setdefault("id", "home" if i == 0 else uid("sheet"))
        sh.setdefault("title", "INFINI REMOTE PRO" if i == 0 else "Sheet")
        sh.setdefault("description", "")
        sh.setdefault("order", i)
        sh.setdefault("created_at", now())
        sh.setdefault("updated_at", now())
        sh.setdefault("slots", [])
        sh["slots"] = [ensure_slot(sl) for sl in sh["slots"]]

    home = st["sheets"][0]
    home.setdefault("slots", [])
    for sh in st["sheets"][1:]:
        link = f"/sheet/{sh['id']}"
        exists = any(sl.get("link_url") == link for sl in home["slots"])
        if not exists:
            home["slots"].append(ensure_slot({
                "id": uid("slot"),
                "title": sh.get("title", "Sheet"),
                "subtitle": "แตะเข้าแผ่นนี้",
                "kind": "sheet",
                "media_url": "",
                "media_type": "",
                "link_url": link,
                "enabled": True,
                "created_at": now(),
                "updated_at": now(),
            }))

    save_state(st)
    return st


def find_sheet(st, sheet_id):
    for sh in st.get("sheets", []):
        if sh.get("id") == sheet_id:
            return sh
    raise HTTPException(404, "sheet not found")


def find_slot(sheet, slot_id):
    for sl in sheet.get("slots", []):
        if sl.get("id") == slot_id:
            return sl
    raise HTTPException(404, "slot not found")


def find_child(slot, child_id):
    for ch in slot.get("children", []):
        if ch.get("id") == child_id:
            return ch
    raise HTTPException(404, "child not found")


def save_upload_file(file: UploadFile):
    original = clean_name(file.filename)
    ext = Path(original).suffix or ".bin"
    name = f"{now()}_{uuid.uuid4().hex[:8]}{ext}"
    dest = UPLOADS / name
    with dest.open("wb") as f:
        shutil.copyfileobj(file.file, f)
    return f"/uploads/{name}", media_type(name, file.content_type or "")


class SheetIn(BaseModel):
    title: str = "New Sheet"
    description: str = ""


class SlotIn(BaseModel):
    title: str = "New Slot"
    subtitle: str = ""
    kind: str = "action"


class SlotPatch(BaseModel):
    title: Optional[str] = None
    subtitle: Optional[str] = None
    kind: Optional[str] = None
    media_url: Optional[str] = None
    media_type: Optional[str] = None
    link_url: Optional[str] = None
    enabled: Optional[bool] = None


class SettingsPatch(BaseModel):
    active_sheet: Optional[str] = None


