<script>
let state=null;
let activeSheetId="home";
let isRoomMode=false;
let selected={type:null,sheetId:null,slotId:null,childId:null};

const $=id=>document.getElementById(id);

function toast(msg){
  const t=$("toast");
  t.textContent=msg;
  t.classList.add("show");
  setTimeout(()=>t.classList.remove("show"),1700);
}

async function api(url,opt={}){
  const res=await fetch(url,{headers:{"Content-Type":"application/json",...(opt.headers||{})},...opt});
  if(!res.ok){throw new Error(await res.text())}
  return await res.json();
}

function sheet(){
  return state.sheets.find(s=>s.id===activeSheetId)||state.sheets[0];
}

async function load(){
  state=await api("/api/state");
  const match=location.pathname.match(/^\/sheet\/([^\/]+)/);
  if(match){
    isRoomMode=true;
    document.body.classList.add("room-mode");
    activeSheetId=decodeURIComponent(match[1]);
    await api("/api/settings",{method:"POST",body:JSON.stringify({active_sheet:activeSheetId})});
  }else{
    isRoomMode=false;
    document.body.classList.remove("room-mode");
    activeSheetId="home";
  }
  render();
}

function render(){
  const s=sheet();

  $("modeText").textContent=isRoomMode?"ห้องใหญ่ · ปัดซ้าย/ขวา":"หน้าแรก Remote · แตะเข้าห้อง";
  $("addSheetBtn").textContent=isRoomMode?"← Remote":"+ แผ่น";
  $("addSlotBtn").textContent=isRoomMode?"+ หน้า":"+ Slot";
  $("copySheetBtn").textContent=isRoomMode?"+ รูปเป็นหน้า":"คัดลอกแผ่น";

  renderTabs();

  $("title").textContent=s.title||"INFINI REMOTE";
  $("desc").textContent=isRoomMode
    ? (s.description||"แต่ละหน้าในห้องปัดลงได้ มีช่องย่อย 5 ช่อง")
    : (s.description||"กดแผ่นเพื่อเข้าห้องใหญ่");

  const grid=$("grid");
  grid.innerHTML="";

  if(isRoomMode){
    s.slots.forEach((slot,i)=>grid.appendChild(makePage(s,slot,i)));
  }else{
    s.slots.forEach(slot=>grid.appendChild(makeSlot(s,slot)));
  }
}

function renderTabs(){
  const box=$("tabs");
  box.innerHTML="";
  state.sheets.forEach(s=>{
    const b=document.createElement("button");
    b.className="tab "+(s.id===activeSheetId?"active":"");
    b.textContent=s.title||"Sheet";
    b.addEventListener("click",async()=>{
      activeSheetId=s.id;
      state=await api("/api/settings",{method:"POST",body:JSON.stringify({active_sheet:s.id})});
      render();
    });
    box.appendChild(b);
  });
}

function mediaHtml(obj, cls="media"){
  if(obj.media_url&&obj.media_type==="video")return `<div class="${cls}"><video src="${obj.media_url}" muted autoplay loop playsinline></video></div>`;
  if(obj.media_url)return `<div class="${cls}"><img src="${obj.media_url}"></div>`;
  return '<div class="plus">+</div>';
}

function makeSlot(s,slot){
  const el=document.createElement("div");
  el.className="slot "+(slot.enabled===false?"off":"");
  el.innerHTML=`
    ${mediaHtml(slot)}
    <button class="remoteBtn" type="button">⚙</button>
    <div class="body">
      <span class="badge">${esc(slot.kind||"action")}</span>
      <h3>${esc(slot.title||"Slot")}</h3>
      <p>${esc(slot.subtitle||"แตะใช้งาน / กด ⚙ ตั้งค่า")}</p>
    </div>
  `;
  bindPress(el,()=>openSlotRemote(s.id,slot.id),()=>useSlot(s.id,slot.id));
  el.querySelector(".remoteBtn").addEventListener("click",e=>{
    e.preventDefault();e.stopPropagation();openSlotRemote(s.id,slot.id);
  });
  return el;
}

function makePage(s,slot,i){
  const el=document.createElement("div");
  el.className="slot pageSlot "+(slot.enabled===false?"off":"");
  let children=(slot.children||[]).slice(0,5);

  el.innerHTML=`
    <div class="pageHero">
      ${mediaHtml(slot)}
      <button class="remoteBtn" type="button">⚙</button>
      <div class="pageHeroShade"></div>
      <div class="pageTitle">
        <span class="badge">หน้า ${i+1}</span>
        <h3>${esc(slot.title||"หน้า")}</h3>
        <p>${esc(slot.subtitle||"ปัดลงเพื่อดูช่องย่อย")}</p>
      </div>
    </div>
    <div class="roomNote">ปัดซ้าย/ขวาเพื่อเปลี่ยนหน้า · ปัดลงในหน้านี้เพื่อดูช่องย่อย</div>
    <div class="subSlots"></div>
  `;

  el.querySelector(".remoteBtn").addEventListener("click",e=>{
    e.preventDefault();e.stopPropagation();openSlotRemote(s.id,slot.id);
  });

  el.querySelector(".pageHero").addEventListener("click",e=>{
    if(e.target.closest(".remoteBtn"))return;
    if(slot.media_url)openViewer(slot);
  });

  const box=el.querySelector(".subSlots");
  children.forEach((ch,idx)=>box.appendChild(makeChild(s,slot,ch,idx)));
  return el;
}

function makeChild(s,slot,ch,idx){
  const el=document.createElement("div");
  el.className="subSlot";

  let mini="";
  if(ch.media_url&&ch.media_type==="video")mini=`<div class="miniMedia"><video src="${ch.media_url}" muted autoplay loop playsinline></video></div>`;
  else if(ch.media_url)mini=`<div class="miniMedia"><img src="${ch.media_url}"></div>`;

  el.innerHTML=`
    ${mini}
    <button class="remoteBtn" type="button">⚙</button>
    <div class="subBody">
      <b>${esc(ch.title||("ย่อย "+(idx+1)))}</b>
      <span>${esc(ch.subtitle||"แตะใช้งาน / กด ⚙ ตั้งค่า")}</span>
    </div>
  `;

  el.addEventListener("click",e=>{
    if(e.target.closest(".remoteBtn"))return;
    useChild(s.id,slot.id,ch.id);
  });

  el.querySelector(".remoteBtn").addEventListener("click",e=>{
    e.preventDefault();e.stopPropagation();openChildRemote(s.id,slot.id,ch.id);
  });

  return el;
}

function bindPress(el,onLong,onTap){
  let sx=0,sy=0,fired=false,timer=null;

  function clear(){
    if(timer){clearTimeout(timer);timer=null;}
  }

  el.addEventListener("pointerdown",e=>{
    if(e.target.closest(".remoteBtn"))return;
    fired=false;
    sx=e.clientX;sy=e.clientY;
    clear();
    timer=setTimeout(()=>{
      fired=true;
      if(navigator.vibrate)navigator.vibrate(35);
      onLong();
    },650);
  });

  el.addEventListener("pointermove",e=>{
    if(Math.abs(e.clientX-sx)>24||Math.abs(e.clientY-sy)>24)clear();
  });

  el.addEventListener("pointerup",e=>{
    if(e.target.closest(".remoteBtn"))return;
    clear();
    if(fired){
      e.preventDefault();e.stopPropagation();return;
    }
    onTap();
  });

  el.addEventListener("pointercancel",clear);
  el.addEventListener("pointerleave",clear);
  el.addEventListener("contextmenu",e=>e.preventDefault());
}

function esc(x){
  return String(x||"").replace(/[&<>"]/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[m]));
}

function getSlot(sheetId,slotId){
  const sh=state.sheets.find(x=>x.id===sheetId);
  return sh.slots.find(x=>x.id===slotId);
}

function getChild(sheetId,slotId,childId){
  return getSlot(sheetId,slotId).children.find(x=>x.id===childId);
}

function useSlot(sheetId,slotId){
  const slot=getSlot(sheetId,slotId);

  if(slot.enabled===false){toast("Slot นี้ปิดอยู่");return;}

  if(slot.link_url&&slot.link_url.trim()){
    location.href=slot.link_url;
    return;
  }

  if(slot.media_url&&slot.media_url.trim()){
    openViewer(slot);
    return;
  }

  openSlotRemote(sheetId,slotId);
}

function useChild(sheetId,slotId,childId){
  const ch=getChild(sheetId,slotId,childId);

  if(ch.enabled===false){toast("ช่องนี้ปิดอยู่");return;}

  if(ch.link_url&&ch.link_url.trim()){
    location.href=ch.link_url;
    return;
  }

  if(ch.media_url&&ch.media_url.trim()){
    openViewer(ch);
    return;
  }

  openChildRemote(sheetId,slotId,childId);
}

function openSlotRemote(sheetId,slotId){
  selected={type:"slot",sheetId,slotId,childId:null};
  const slot=getSlot(sheetId,slotId);
  $("drawerTitle").textContent=isRoomMode?"Remote Page":"Remote Slot";
  fillForm(slot,`Sheet / ${slot.title}`);
}

function openChildRemote(sheetId,slotId,childId){
  selected={type:"child",sheetId,slotId,childId};
  const ch=getChild(sheetId,slotId,childId);
  $("drawerTitle").textContent="Remote ช่องย่อย";
  fillForm(ch,`ช่องย่อย / ${ch.title}`);
}

function fillForm(obj,meta){
  $("meta").textContent=meta;
  $("fTitle").value=obj.title||"";
  $("fSubtitle").value=obj.subtitle||"";
  $("fKind").value=obj.kind||"action";
  $("fLink").value=obj.link_url||"";
  $("fEnabled").checked=obj.enabled!==false;
  $("fFile").value="";
  showPreview(obj);
  $("back").classList.add("show");
  $("drawer").classList.add("show");
}

function closeRemote(){
  $("back").classList.remove("show");
  $("drawer").classList.remove("show");
}

function showPreview(obj){
  const p=$("preview");
  if(obj.media_url&&obj.media_type==="video")p.innerHTML=`<video src="${obj.media_url}" controls playsinline></video>`;
  else if(obj.media_url)p.innerHTML=`<img src="${obj.media_url}">`;
  else p.textContent="ยังไม่มีสื่อ";
}

async function saveTarget(){
  const body={
    title:$("fTitle").value,
    subtitle:$("fSubtitle").value,
    kind:$("fKind").value,
    link_url:$("fLink").value,
    enabled:$("fEnabled").checked
  };

  if(selected.type==="child"){
    state=await api(`/api/sheets/${selected.sheetId}/slots/${selected.slotId}/children/${selected.childId}`,{method:"PATCH",body:JSON.stringify(body)});
  }else{
    state=await api(`/api/sheets/${selected.sheetId}/slots/${selected.slotId}`,{method:"PATCH",body:JSON.stringify(body)});
  }

  toast("บันทึกแล้ว");
  render();
}

async function uploadTarget(){
  const file=$("fFile").files[0];
  if(!file){toast("เลือกรูปหรือวิดีโอก่อน");return;}

  const fd=new FormData();
  fd.append("file",file);

  let url=selected.type==="child"
    ? `/api/sheets/${selected.sheetId}/slots/${selected.slotId}/children/${selected.childId}/upload`
    : `/api/sheets/${selected.sheetId}/slots/${selected.slotId}/upload`;

  const res=await fetch(url,{method:"POST",body:fd});
  if(!res.ok){toast("อัปโหลดไม่สำเร็จ");return;}

  state=await res.json();
  toast("อัปโหลดแล้ว");
  render();
}

async function clearTarget(){
  const body={media_url:"",media_type:""};

  if(selected.type==="child"){
    state=await api(`/api/sheets/${selected.sheetId}/slots/${selected.slotId}/children/${selected.childId}`,{method:"PATCH",body:JSON.stringify(body)});
  }else{
    state=await api(`/api/sheets/${selected.sheetId}/slots/${selected.slotId}`,{method:"PATCH",body:JSON.stringify(body)});
  }

  toast("ล้างสื่อแล้ว");
  render();
}

async function deleteTarget(){
  if(selected.type==="child"){
    state=await api(`/api/sheets/${selected.sheetId}/slots/${selected.slotId}/children/${selected.childId}`,{
      method:"PATCH",
      body:JSON.stringify({title:"ช่องย่อย",subtitle:"กด ⚙ เพื่อตั้งค่า",kind:"subslot",media_url:"",media_type:"",link_url:"",enabled:true})
    });
    toast("รีเซ็ตช่องย่อยแล้ว");
    render();
    return;
  }

  if(!confirm("ลบหน้านี้/Slot นี้ใช่ไหม"))return;

  state=await api(`/api/sheets/${selected.sheetId}/slots/${selected.slotId}`,{method:"DELETE"});
  closeRemote();
  toast("ลบแล้ว");
  render();
}

async function addSheet(){
  if(isRoomMode){
    location.href="/";
    return;
  }

  const title=prompt("ชื่อแผ่นใหม่","ห้องใหม่");
  if(title===null)return;

  state=await api("/api/sheets",{method:"POST",body:JSON.stringify({title})});
  toast("สร้างแผ่นและประตูเข้าแล้ว");
  render();
}

async function addSlot(){
  if(isRoomMode){
    const title=prompt("ชื่อหน้าใหม่","หน้า "+(sheet().slots.length+1));
    if(title===null)return;

    state=await api(`/api/sheets/${activeSheetId}/slots`,{
      method:"POST",
      body:JSON.stringify({title,kind:"page",subtitle:"ปัดลงเพื่อดูช่องย่อย 5 ช่อง"})
    });

    toast("เพิ่มหน้าแล้ว");
    render();
    setTimeout(()=>{$("grid").scrollLeft=$("grid").scrollWidth},80);
    return;
  }

  const title=prompt("ชื่อ Slot ใหม่","New Slot");
  if(title===null)return;

  state=await api(`/api/sheets/${activeSheetId}/slots`,{
    method:"POST",
    body:JSON.stringify({title,kind:"action"})
  });

  toast("เพิ่ม Slot แล้ว");
  render();
}

async function copySheet(){
  if(isRoomMode){
    $("roomFiles").click();
    return;
  }

  state=await api(`/api/sheets/${activeSheetId}/duplicate`,{method:"POST",body:"{}"});
  toast("คัดลอกแผ่นแล้ว");
  render();
}

async function uploadPages(files){
  if(!files.length)return;

  const fd=new FormData();
  [...files].forEach(f=>fd.append("files",f));

  const res=await fetch(`/api/sheets/${activeSheetId}/upload-pages`,{method:"POST",body:fd});
  if(!res.ok){toast("สร้างหน้าไม่สำเร็จ");return;}

  state=await res.json();
  toast("สร้างรูป/วิดีโอเป็นหน้าแล้ว");
  render();
  setTimeout(()=>{$("grid").scrollLeft=$("grid").scrollWidth},100);
}

function openViewer(obj){
  const b=$("viewerBody");
  b.innerHTML=obj.media_type==="video"
    ? `<video src="${obj.media_url}" controls autoplay playsinline></video>`
    : `<img src="${obj.media_url}">`;
  $("viewer").classList.add("show");
}

function closeViewer(){
  $("viewer").classList.remove("show");
}

$("addSheetBtn").addEventListener("click",addSheet);
$("addSlotBtn").addEventListener("click",addSlot);
$("copySheetBtn").addEventListener("click",copySheet);
$("roomFiles").addEventListener("change",e=>uploadPages(e.target.files));

$("shareBtn").addEventListener("click",async()=>{
  try{
    await navigator.clipboard.writeText(location.href);
    toast("คัดลอกลิงก์แล้ว");
  }catch(e){
    prompt("Copy link",location.href);
  }
});

$("back").addEventListener("click",closeRemote);
$("closeBtn").addEventListener("click",closeRemote);
$("saveBtn").addEventListener("click",saveTarget);
$("uploadBtn").addEventListener("click",uploadTarget);
$("clearBtn").addEventListener("click",clearTarget);
$("deleteBtn").addEventListener("click",deleteTarget);
$("closeViewerBtn").addEventListener("click",closeViewer);

$("viewer").addEventListener("click",e=>{
  if(e.target.id==="viewer")closeViewer();
});

load().catch(e=>{
  console.error(e);
  toast("โหลดผิดพลาด");
});
</script>
</body>
</html>
'''


def simple_page(title, desc):
    return f"""<!doctype html><html lang='th'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>{title}</title><style>body{{margin:0;min-height:100vh;background:radial-gradient(circle at top,#2b1304,#050302 48%,#000);color:#fff7ef;font-family:system-ui;padding:18px}}.card{{max-width:720px;margin:30px auto;border:1px solid rgba(255,133,0,.35);border-radius:28px;background:rgba(18,9,5,.75);padding:22px}}h1{{margin:0 0 10px;font-size:32px}}p{{color:#ffd7ad;line-height:1.55}}a{{display:inline-block;margin-top:16px;background:linear-gradient(135deg,#ffb000,#ff8500);color:#190700;text-decoration:none;border-radius:16px;padding:12px 16px;font-weight:900}}</style></head><body><div class='card'><h1>{title}</h1><p>{desc}</p><a href='/'>← กลับ Remote</a></div></body></html>"""


@app.get("/", response_class=HTMLResponse)
def home():
    return HTMLResponse(HTML)


@app.get("/sheet/{sheet_id}", response_class=HTMLResponse)
def open_sheet_page(sheet_id: str):
    return HTMLResponse(HTML)


@app.get("/creative", response_class=HTMLResponse)
def creative():
    return HTMLResponse(simple_page("Creative", "ห้องสร้างแผ่นงาน"))


@app.get("/space", response_class=HTMLResponse)
def space():
    return HTMLResponse(simple_page("Space", "หน้าสาธารณะ"))


@app.get("/zone", response_class=HTMLResponse)
def zone():
    return HTMLResponse(simple_page("Zone", "โซน / ห้อง / ร้าน"))


@app.get("/upload-room", response_class=HTMLResponse)
def upload_room():
    return HTMLResponse(simple_page("Upload Engine", "ห้องอัปโหลด"))


@app.get("/link-room", response_class=HTMLResponse)
def link_room():
    return HTMLResponse(simple_page("Link Engine", "ห้องเชื่อมลิงก์"))


@app.get("/setting-room", response_class=HTMLResponse)
def setting_room():
    return HTMLResponse(simple_page("Setting Engine", "ห้องตั้งค่า"))


@app.get("/health")
def health():
    return {"ok": True, "app": APP_NAME, "port": 7000}


@app.get("/api/state")
def api_state():
    return JSONResponse(load_state())


@app.post("/api/settings")
def api_settings(p: SettingsPatch):
    st = load_state()
    data = dump_model(p)
    for k, v in data.items():
        if v is not None:
            st["settings"][k] = v
    save_state(st)
    return JSONResponse(st)


@app.post("/api/sheets")
def api_add_sheet(p: SheetIn):
    st = load_state()
    sheet_id = uid("sheet")
    title = p.title.strip() or "ห้องใหม่"

    sheet = {
        "id": sheet_id,
        "title": title,
        "description": p.description.strip() or "ห้องใหญ่ของแผ่นนี้ · ปัดซ้ายขวาเป็นหน้า · ปัดลงเป็นช่องย่อย",
        "order": len(st["sheets"]),
        "created_at": now(),
        "updated_at": now(),
        "slots": [new_page("หน้า 1", "กด + รูปเป็นหน้า หรือกด ⚙ เพื่ออัปโหลด")],
    }

    st["sheets"].append(sheet)

    home = st["sheets"][0]
    home.setdefault("slots", [])
    home["slots"].append(ensure_slot({
        "id": uid("slot"),
        "title": title,
        "subtitle": "แตะเข้าแผ่นนี้",
        "kind": "sheet",
        "media_url": "",
        "media_type": "",
        "link_url": f"/sheet/{sheet_id}",
        "enabled": True,
        "created_at": now(),
        "updated_at": now(),
    }))

    st["settings"]["active_sheet"] = "home"
    save_state(st)
    return JSONResponse(st)


@app.post("/api/sheets/{sheet_id}/duplicate")
def api_dup_sheet(sheet_id: str):
    st = load_state()
    old = find_sheet(st, sheet_id)

    new = json.loads(json.dumps(old, ensure_ascii=False))
    new["id"] = uid("sheet")
    new["title"] = old.get("title", "Sheet") + " Copy"
    new["order"] = len(st["sheets"])
    new["created_at"] = now()
    new["updated_at"] = now()

    for sl in new.get("slots", []):
        sl["id"] = uid("slot")
        for ch in sl.get("children", []):
            ch["id"] = uid("child")

    st["sheets"].append(new)

    home = st["sheets"][0]
    home.setdefault("slots", [])
    home["slots"].append(ensure_slot({
        "id": uid("slot"),
        "title": new["title"],
        "subtitle": "แตะเข้าแผ่นนี้",
        "kind": "sheet",
        "media_url": "",
        "media_type": "",
        "link_url": f"/sheet/{new['id']}",
        "enabled": True,
        "created_at": now(),
        "updated_at": now(),
    }))

    st["settings"]["active_sheet"] = "home"
    save_state(st)
    return JSONResponse(st)


@app.post("/api/sheets/{sheet_id}/slots")
def api_add_slot(sheet_id: str, p: SlotIn):
    st = load_state()
    sh = find_sheet(st, sheet_id)
    kind = p.kind.strip() or "action"

    if sheet_id != "home" or kind == "page":
        sl = new_page(
            p.title.strip() or f"หน้า {len(sh.get('slots', [])) + 1}",
            p.subtitle.strip() or "ปัดลงเพื่อดูช่องย่อย 5 ช่อง"
        )
        sl["kind"] = "page"
    else:
        sl = ensure_slot({
            "id": uid("slot"),
            "title": p.title.strip() or "New Slot",
            "subtitle": p.subtitle.strip() or "แตะใช้งาน / กด ⚙ ตั้งค่า",
            "kind": kind,
            "media_url": "",
            "media_type": "",
            "link_url": DEFAULT_LINKS.get(kind, ""),
            "enabled": True,
            "created_at": now(),
            "updated_at": now(),
        })

    sh.setdefault("slots", []).append(sl)
    sh["updated_at"] = now()
    save_state(st)
    return JSONResponse(st)


@app.patch("/api/sheets/{sheet_id}/slots/{slot_id}")
def api_patch_slot(sheet_id: str, slot_id: str, p: SlotPatch):
    st = load_state()
    sh = find_sheet(st, sheet_id)
    sl = find_slot(sh, slot_id)

    data = dump_model(p)
    for k, v in data.items():
        if k in ["title", "subtitle", "kind", "media_url", "media_type", "link_url", "enabled"]:
            sl[k] = v

    sl["updated_at"] = now()
    sh["updated_at"] = now()
    save_state(st)
    return JSONResponse(st)


@app.delete("/api/sheets/{sheet_id}/slots/{slot_id}")
def api_delete_slot(sheet_id: str, slot_id: str):
    st = load_state()
    sh = find_sheet(st, sheet_id)

    before = len(sh.get("slots", []))
    sh["slots"] = [x for x in sh.get("slots", []) if x.get("id") != slot_id]

    if len(sh["slots"]) == before:
        raise HTTPException(404, "slot not found")

    sh["updated_at"] = now()
    save_state(st)
    return JSONResponse(st)


@app.post("/api/sheets/{sheet_id}/slots/{slot_id}/upload")
def api_upload_slot(sheet_id: str, slot_id: str, file: UploadFile = File(...)):
    st = load_state()
    sh = find_sheet(st, sheet_id)
    sl = find_slot(sh, slot_id)

    url, mt = save_upload_file(file)
    sl["media_url"] = url
    sl["media_type"] = mt
    sl["updated_at"] = now()
    sh["updated_at"] = now()

    save_state(st)
    return JSONResponse(st)


@app.patch("/api/sheets/{sheet_id}/slots/{slot_id}/children/{child_id}")
def api_patch_child(sheet_id: str, slot_id: str, child_id: str, p: SlotPatch):
    st = load_state()
    sh = find_sheet(st, sheet_id)
    sl = find_slot(sh, slot_id)
    ch = find_child(sl, child_id)

    data = dump_model(p)
    for k, v in data.items():
        if k in ["title", "subtitle", "kind", "media_url", "media_type", "link_url", "enabled"]:
            ch[k] = v

    ch["updated_at"] = now()
    sl["updated_at"] = now()
    sh["updated_at"] = now()

    save_state(st)
    return JSONResponse(st)


@app.post("/api/sheets/{sheet_id}/slots/{slot_id}/children/{child_id}/upload")
def api_upload_child(sheet_id: str, slot_id: str, child_id: str, file: UploadFile = File(...)):
    st = load_state()
    sh = find_sheet(st, sheet_id)
    sl = find_slot(sh, slot_id)
    ch = find_child(sl, child_id)

    url, mt = save_upload_file(file)
    ch["media_url"] = url
    ch["media_type"] = mt
    ch["updated_at"] = now()
    sl["updated_at"] = now()
    sh["updated_at"] = now()

    save_state(st)
    return JSONResponse(st)


@app.post("/api/sheets/{sheet_id}/upload-pages")
def api_upload_pages(sheet_id: str, files: List[UploadFile] = File(...)):
    st = load_state()
    sh = find_sheet(st, sheet_id)
    sh.setdefault("slots", [])

    for file in files:
        url, mt = save_upload_file(file)
        title = Path(file.filename or "หน้าใหม่").stem[:30] or f"หน้า {len(sh['slots']) + 1}"

        empty = None
        for sl in sh["slots"]:
            if not sl.get("media_url") and str(sl.get("kind", "")) in ["page", "action"]:
                empty = sl
                break

        if empty:
            empty["title"] = title
            empty["subtitle"] = "หน้านี้สร้างจากรูป/วิดีโอ"
            empty["kind"] = "page"
            empty["media_url"] = url
            empty["media_type"] = mt
            empty["children"] = empty.get("children") or default_children()
            empty["updated_at"] = now()
        else:
            sh["slots"].append(new_page(title, "หน้านี้สร้างจากรูป/วิดีโอ", url, mt))

    sh["updated_at"] = now()
    save_state(st)
    return JSONResponse(st)
