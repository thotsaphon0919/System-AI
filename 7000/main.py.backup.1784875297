.tab{white-space:nowrap;border:1px solid var(--line);border-radius:999px;background:rgba(255,133,0,.06);color:var(--muted);padding:9px 12px;font-weight:900}
.tab.active{background:linear-gradient(135deg,var(--orange2),var(--orange));color:#1a0800}
.head{border:1px solid var(--line);border-radius:24px;background:rgba(18,9,5,.74);padding:14px;margin:2px 0 14px}
