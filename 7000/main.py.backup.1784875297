from fastapi import FastAPI, UploadFile, File, HTTPException
from fastapi.responses import HTMLResponse, JSONResponse
from fastapi.staticfiles import StaticFiles
from pydantic import BaseModel
from pathlib import Path
from typing import Optional
import json, shutil, uuid, time, re, mimetypes

APP_NAME = "INFINI Remote PRO V1"
BASE = Path(__file__).resolve().parent
DATA = BASE / "data"
UPLOADS = BASE / "uploads"
STATE = DATA / "remote_state.json"

DATA.mkdir(parents=True, exist_ok=True)
UPLOADS.mkdir(parents=True, exist_ok=True)

app = FastAPI(title=APP_NAME)
app.mount("/uploads", StaticFiles(directory=str(UPLOADS)), name="uploads")


def now():
    return int(time.time())


def uid(p):
    return f"{p}_{uuid.uuid4().hex[:10]}"


def clean_name(name):
    name = name or "upload.bin"
    name = re.sub(r"[^a-zA-Z0-9._-]+", "-", name)
    return name[:80] or "upload.bin"


def media_type(filename, content_type=""):
    ct = (content_type or mimetypes.guess_type(filename)[0] or "").lower()
    return "video" if ct.startswith("video/") else "image"


def dump_model(m):
    if hasattr(m, "model_dump"):
        return m.model_dump(exclude_unset=True)
    return m.dict(exclude_unset=True)


DEFAULT_LINKS = {
    "creative": "/creative",
    "space": "/space",
    "zone": "/zone",
    "upload": "/upload-room",
    "link": "/link-room",
    "setting": "/setting-room",
}


def default_state():
    defs = [
        ("Creative", "สร้าง/เปิดแผ่นงาน", "creative"),
        ("Space", "หน้าสาธารณะ", "space"),
        ("Zone", "โซน / ห้อง / ร้าน", "zone"),
        ("Upload", "รูป / วิดีโอ", "upload"),
        ("Link", "เชื่อมหน้า / เว็บ", "link"),
        ("Setting", "ตั้งค่า Slot", "setting"),
    ]
    slots = []
    for title, sub, kind in defs:
        slots.append({
            "id": uid("slot"),
            "title": title,
            "subtitle": sub,
            "kind": kind,
            "media_url": "",
            "media_type": "",
            "link_url": DEFAULT_LINKS.get(kind, ""),
            "enabled": True,
            "created_at": now(),
            "updated_at": now(),
        })
    return {
        "app": APP_NAME,
        "settings": {
            "active_sheet": "home",
            "theme": "orange-black",
            "port": 7000,
        },
        "sheets": [{
            "id": "home",
            "title": "INFINI REMOTE PRO",
            "description": "แตะ Slot = ใช้งาน / กดค้าง Slot = เปิด Remote เพื่อใส่รูป วิดีโอ ลิงก์ และตั้งค่า",
            "order": 0,
            "created_at": now(),
            "updated_at": now(),
            "slots": slots,
        }]
    }


def load_state():
    if not STATE.exists():
        save_state(default_state())

    try:
        with STATE.open("r", encoding="utf-8") as f:
            st = json.load(f)
    except Exception:
        st = default_state()
        save_state(st)

    st.setdefault("settings", {})
    st["settings"].setdefault("active_sheet", "home")
    st.setdefault("sheets", [])

    if not st["sheets"]:
        st = default_state()

    for sheet in st["sheets"]:
        sheet.setdefault("slots", [])
        sheet.setdefault("description", "")
        for slot in sheet["slots"]:
            slot.setdefault("id", uid("slot"))
            slot.setdefault("title", "Slot")
            slot.setdefault("subtitle", "")
            slot.setdefault("kind", "action")
            slot.setdefault("media_url", "")
            slot.setdefault("media_type", "")
            slot.setdefault("link_url", "")
            slot.setdefault("enabled", True)

            k = str(slot.get("kind", "")).lower()
            if not slot.get("link_url") and k in DEFAULT_LINKS:
                slot["link_url"] = DEFAULT_LINKS[k]

    save_state(st)
    return st


def save_state(st):
    tmp = STATE.with_suffix(".tmp")
    with tmp.open("w", encoding="utf-8") as f:
        json.dump(st, f, ensure_ascii=False, indent=2)
    tmp.replace(STATE)
    return st


def find_sheet(st, sheet_id):
    for s in st["sheets"]:
        if s["id"] == sheet_id:
            return s
    raise HTTPException(404, "sheet not found")


def find_slot(sheet, slot_id):
    for sl in sheet["slots"]:
        if sl["id"] == slot_id:
            return sl
    raise HTTPException(404, "slot not found")


class SheetIn(BaseModel):
    title: str = "New Sheet"
    description: str = ""


class SlotIn(BaseModel):
    title: str = "New Slot"
    subtitle: str = ""
    kind: str = "action"


class SlotPatch(BaseModel):
    title: Optional[str] = None
    subtitle: Optional[str] = None
    kind: Optional[str] = None
    media_url: Optional[str] = None
    media_type: Optional[str] = None
    link_url: Optional[str] = None
    enabled: Optional[bool] = None


class SettingsPatch(BaseModel):
    active_sheet: Optional[str] = None


HTML = r"""
<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
