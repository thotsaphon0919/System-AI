@app.get("/api/state")
def api_state():
    return JSONResponse(load_state())


@app.post("/api/settings")
def api_settings(p: SettingsPatch):
    st = load_state()
    data = dump_model(p)
    for k, v in data.items():
        if v is not None:
            st["settings"][k] = v
    save_state(st)
    return JSONResponse(st)


@app.post("/api/sheets")
def api_add_sheet(p: SheetIn):
    st = load_state()
    sheet_id = uid("sheet")
    title = p.title.strip() or "New Sheet"

    sheet = {
        "id": sheet_id,
        "title": title,
        "description": p.description.strip() or "แผ่นใหม่ของ INFINI Remote",
        "order": len(st["sheets"]),
        "created_at": now(),
        "updated_at": now(),
        "slots": [
            {
                "id": uid("slot"),
                "title": "กลับ Remote หลัก",
                "subtitle": "แตะเพื่อกลับหน้าแรก",
                "kind": "link",
                "media_url": "",
                "media_type": "",
                "link_url": "/",
                "enabled": True,
                "created_at": now(),
                "updated_at": now(),
            },
            {
                "id": uid("slot"),
                "title": "ใส่หน้าปกแผ่นนี้",
                "subtitle": "กด ⚙ เพื่ออัปโหลดรูปหรือวิดีโอ",
                "kind": "upload",
                "media_url": "",
                "media_type": "",
                "link_url": "",
                "enabled": True,
                "created_at": now(),
                "updated_at": now(),
            },
            {
                "id": uid("slot"),
                "title": "ช่องต่อไป",
                "subtitle": "กด ⚙ เพื่อตั้งลิงก์/รูป/วิดีโอ",
                "kind": "action",
                "media_url": "",
                "media_type": "",
                "link_url": "",
                "enabled": True,
                "created_at": now(),
                "updated_at": now(),
            },
        ],
    }

    st["sheets"].append(sheet)

    # สร้าง Slot ทางเข้าแผ่นใหม่บนหน้าแรก
    home = st["sheets"][0]
    home.setdefault("slots", [])
    home["slots"].append({
        "id": uid("slot"),
        "title": title,
        "subtitle": "แตะเข้าแผ่นนี้",
        "kind": "sheet",
        "media_url": "",
        "media_type": "",
        "link_url": f"/sheet/{sheet_id}",
        "enabled": True,
        "created_at": now(),
        "updated_at": now(),
    })
    home["updated_at"] = now()

    st["settings"]["active_sheet"] = sheet_id
    save_state(st)
    return JSONResponse(st)

@app.post("/api/sheets/{sheet_id}/duplicate")
def api_dup_sheet(sheet_id: str):
    st = load_state()
    old = find_sheet(st, sheet_id)
    new = json.loads(json.dumps(old, ensure_ascii=False))
    new["id"] = uid("sheet")
    new["title"] = old.get("title", "Sheet") + " Copy"
    new["order"] = len(st["sheets"])
    new["created_at"] = now()
    new["updated_at"] = now()
    for sl in new.get("slots", []):
        sl["id"] = uid("slot")
    st["sheets"].append(new)
    st["settings"]["active_sheet"] = new["id"]
    save_state(st)
    return JSONResponse(st)


@app.post("/api/sheets/{sheet_id}/slots")
def api_add_slot(sheet_id: str, p: SlotIn):
    st = load_state()
    s = find_sheet(st, sheet_id)
    k = p.kind.strip() or "action"
    sl = {
        "id": uid("slot"),
        "title": p.title.strip() or "New Slot",
        "subtitle": p.subtitle.strip(),
        "kind": k,
        "media_url": "",
        "media_type": "",
        "link_url": DEFAULT_LINKS.get(k, ""),
        "enabled": True,
        "created_at": now(),
        "updated_at": now(),
    }
    s["slots"].append(sl)
    s["updated_at"] = now()
    save_state(st)
    return JSONResponse(st)


@app.patch("/api/sheets/{sheet_id}/slots/{slot_id}")
def api_patch_slot(sheet_id: str, slot_id: str, p: SlotPatch):
    st = load_state()
    s = find_sheet(st, sheet_id)
    sl = find_slot(s, slot_id)
    data = dump_model(p)
    for k, v in data.items():
        if k in ["title", "subtitle", "kind", "media_url", "media_type", "link_url", "enabled"]:
            sl[k] = v
    sl["updated_at"] = now()
    s["updated_at"] = now()
    save_state(st)
    return JSONResponse(st)


@app.delete("/api/sheets/{sheet_id}/slots/{slot_id}")
def api_delete_slot(sheet_id: str, slot_id: str):
    st = load_state()
    s = find_sheet(st, sheet_id)
    s["slots"] = [x for x in s["slots"] if x["id"] != slot_id]
    s["updated_at"] = now()
    save_state(st)
    return JSONResponse(st)


@app.post("/api/sheets/{sheet_id}/slots/{slot_id}/upload")
def api_upload(sheet_id: str, slot_id: str, file: UploadFile = File(...)):
    st = load_state()
    s = find_sheet(st, sheet_id)
    sl = find_slot(s, slot_id)

    original = clean_name(file.filename)
    ext = Path(original).suffix or ".bin"
    name = f"{now()}_{uuid.uuid4().hex[:8]}{ext}"
    dest = UPLOADS / name

    with dest.open("wb") as f:
        shutil.copyfileobj(file.file, f)

    sl["media_url"] = f"/uploads/{name}"
    sl["media_type"] = media_type(name, file.content_type or "")
    sl["updated_at"] = now()
    s["updated_at"] = now()

    save_state(st)
    return JSONResponse(st)
