.slot{position:relative;min-height:166px;border:1px solid var(--line);border-radius:25px;overflow:hidden;background:linear-gradient(160deg,rgba(255,133,0,.18),rgba(0,0,0,.96));box-shadow:0 18px 40px rgba(0,0,0,.35);touch-action:pan-y;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}
.slot:active{transform:scale(.985)}
.slot.off{opacity:.45}
.media{position:absolute;inset:0}
.media img,.media video{width:100%;height:100%;object-fit:cover;display:block}
.plus{position:absolute;inset:0;display:grid;place-items:center;font-size:58px;color:rgba(255,160,0,.24);font-weight:200}
.slot:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.08),rgba(0,0,0,.82))}
.body{position:absolute;left:0;right:0;bottom:0;z-index:2;padding:14px}
.badge{display:inline-block;border-radius:999px;background:linear-gradient(135deg,var(--orange2),var(--orange));color:#160600;font-size:12px;font-weight:1000;padding:7px 12px;text-transform:uppercase}
.body h3{font-size:21px;margin:10px 0 4px}
.body p{font-size:14px;margin:0;color:#ffd7ad}
.bar{position:fixed;left:50%;bottom:13px;transform:translateX(-50%);width:min(960px,calc(100% - 22px));display:flex;gap:8px;padding:10px;border:1px solid var(--line);border-radius:24px;background:rgba(9,4,2,.86);backdrop-filter:blur(14px);z-index:20}
.bar .btn{flex:1}
.toast{position:fixed;top:10px;left:50%;transform:translateX(-50%);z-index:99;background:#1a0b04;border:1px solid var(--line);border-radius:999px;padding:11px 15px;color:#ffd7ad;display:none}
.toast.show{display:block}
.back{position:fixed;inset:0;background:rgba(0,0,0,.62);z-index:40;display:none}
.back.show{display:block}
.drawer{position:fixed;left:0;right:0;bottom:0;z-index:50;max-height:88vh;overflow:auto;background:linear-gradient(180deg,#251006,#050302);border-top:1px solid var(--line);border-radius:28px 28px 0 0;transform:translateY(105%);transition:.22s}
.drawer.show{transform:translateY(0)}
.inner{padding:18px;max-width:760px;margin:auto}
.inner h2{margin:0 0 4px}
.small{font-size:12px;color:var(--muted);margin-bottom:12px}
.field{margin-bottom:10px}
label{display:block;color:#ffd7ad;font-size:12px;font-weight:900;margin-bottom:5px}
input,textarea,select{width:100%;border:1px solid var(--line);background:#070402;color:var(--text);border-radius:14px;padding:12px;font:inherit;outline:none}
.preview{min-height:125px;border:1px dashed var(--line);border-radius:18px;margin-bottom:12px;display:grid;place-items:center;overflow:hidden;color:#ffd7ad;background:#070402}
.preview img,.preview video{width:100%;max-height:260px;object-fit:contain}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.viewer{position:fixed;inset:0;background:rgba(0,0,0,.94);z-index:80;display:none;place-items:center;padding:16px}
.viewer.show{display:grid}
.viewer img,.viewer video{max-width:100%;max-height:86vh;border-radius:18px}
.closev{position:absolute;top:12px;right:12px}

.remoteBtn{
  position:absolute;
  top:9px;
  right:9px;
  z-index:5;
  border:1px solid rgba(255,176,0,.55);
  background:rgba(0,0,0,.62);
  color:#ffb000;
  border-radius:999px;
  width:38px;
  height:38px;
  font-size:18px;
  font-weight:900;
}

</style>
</head>
<body>
<div class="toast" id="toast"></div>

<div class="app">
  <div class="top">
    <div class="brand">
      <div class="logo">∞</div>
      <div>
        <h1>INFINI REMOTE PRO V1</h1>
        <div class="sub">แตะ = ใช้งาน / กดค้าง = เปิด Remote</div>
      </div>
    </div>
    <button class="btn" id="shareBtn">แชร์</button>
  </div>

  <div class="tabs" id="tabs"></div>

  <div class="head">
    <h2 id="title">Loading</h2>
    <p id="desc"></p>
  </div>

  <div class="grid" id="grid"></div>
</div>

<div class="bar">
  <button class="btn primary" id="addSheetBtn">+ แผ่น</button>
  <button class="btn primary" id="addSlotBtn">+ Slot</button>
  <button class="btn" id="copySheetBtn">คัดลอกแผ่น</button>
</div>

<div class="back" id="back"></div>
<div class="drawer" id="drawer">
  <div class="inner">
    <h2>Remote Slot</h2>
    <div class="small" id="meta">Setting Engine</div>

    <div class="preview" id="preview">ยังไม่มีสื่อ</div>

    <div class="field">
      <label>ชื่อ Slot</label>
      <input id="fTitle">
    </div>

    <div class="field">
      <label>คำอธิบาย</label>
      <textarea id="fSubtitle" rows="2"></textarea>
    </div>

    <div class="field">
      <label>ชนิด Slot</label>
      <select id="fKind">
        <option value="creative">creative</option>
        <option value="space">space</option>
        <option value="zone">zone</option>
        <option value="upload">upload</option>
        <option value="link">link</option>
        <option value="setting">setting</option>
        <option value="action">action</option>
        <option value="sheet">sheet</option>
      </select>
    </div>

    <div class="field">
      <label>ลิงก์ที่แตะแล้วเปิด</label>
      <input id="fLink" placeholder="/creative หรือ https://...">
    </div>

    <div class="field">
      <label>รูป / วิดีโอ</label>
      <input id="fFile" type="file" accept="image/*,video/*">
    </div>

    <div class="field">
      <label><input id="fEnabled" type="checkbox"> เปิดใช้งาน</label>
    </div>

    <div class="actions">
      <button class="btn primary" id="saveBtn">บันทึก</button>
      <button class="btn" id="uploadBtn">อัปโหลด</button>
      <button class="btn" id="clearBtn">ล้างสื่อ</button>
      <button class="btn danger" id="deleteBtn">ลบ Slot</button>
