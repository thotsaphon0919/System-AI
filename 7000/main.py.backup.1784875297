<div class="viewer" id="viewer">
  <button class="btn closev" id="closeViewerBtn">ปิด</button>
  <div id="viewerBody"></div>
</div>

<script>
let state = null;
let activeSheetId = "home";
let selected = {sheetId:null, slotId:null};
let pressTimer = null;
let longPress = false;

const $ = id => document.getElementById(id);

function toast(msg){
  const t = $("toast");
  t.textContent = msg;
  t.classList.add("show");
  setTimeout(()=>t.classList.remove("show"),1700);
}

async function api(url, opt={}){
  const res = await fetch(url, {
    headers: {"Content-Type":"application/json", ...(opt.headers||{})},
    ...opt
  });
  if(!res.ok){
    const txt = await res.text();
    throw new Error(txt);
  }
  return await res.json();
}

function sheet(){
  return state.sheets.find(s=>s.id===activeSheetId) || state.sheets[0];
}

async function load(){
  state = await api("/api/state");

  const m = location.pathname.match(/^\/sheet\/([^\/]+)/);
  if(m){
    activeSheetId = decodeURIComponent(m[1]);
    await api("/api/settings", {
      method:"POST",
      body:JSON.stringify({active_sheet:activeSheetId})
    });
  }else{
    activeSheetId = state.settings.active_sheet || state.sheets[0].id;
  }

  render();
}

function render(){
  renderTabs();
  const s = sheet();
  $("title").textContent = s.title || "INFINI REMOTE";
  $("desc").textContent = s.description || "แตะเพื่อเปิด / กดค้างเพื่อแก้";

  const grid = $("grid");
  grid.innerHTML = "";

  s.slots.forEach(slot=>{
    grid.appendChild(makeSlot(s, slot));
  });
}

function renderTabs(){
  const box = $("tabs");
  box.innerHTML = "";
  state.sheets.forEach(s=>{
    const b = document.createElement("button");
    b.className = "tab " + (s.id===activeSheetId ? "active" : "");
    b.textContent = s.title || "Sheet";
    b.addEventListener("click", async ()=>{
      activeSheetId = s.id;
      state = await api("/api/settings", {
        method:"POST",
        body:JSON.stringify({active_sheet:s.id})
      });
      render();
    });
    box.appendChild(b);
  });
}

function makeSlot(s, slot){
  const el = document.createElement("div");
  el.className = "slot " + (slot.enabled === false ? "off" : "");

  let media = '<div class="plus">+</div>';
  if(slot.media_url && slot.media_type === "video"){
    media = `<div class="media"><video src="${slot.media_url}" muted autoplay loop playsinline></video></div>`;
  }else if(slot.media_url){
    media = `<div class="media"><img src="${slot.media_url}"></div>`;
  }

  el.innerHTML = `
    ${media}
    <button class="remoteBtn" type="button">⚙</button>
    <div class="body">
      <span class="badge">${esc(slot.kind || "action")}</span>
      <h3>${esc(slot.title || "Slot")}</h3>
      <p>${esc(slot.subtitle || "แตะใช้งาน / กดค้างแก้ไข")}</p>
    </div>
  `;

  const remoteBtn = el.querySelector(".remoteBtn");
  remoteBtn.addEventListener("click", (e)=>{
    e.preventDefault();
    e.stopPropagation();
    openRemote(s.id, slot.id);
  });

  let timer = null;
  let fired = false;
  let sx = 0;
  let sy = 0;

  function clearPress(){
    if(timer){
      clearTimeout(timer);
      timer = null;
    }
  }

  function startPress(x, y){
    fired = false;
    sx = x;
    sy = y;
    clearPress();

    timer = setTimeout(()=>{
      fired = true;
      if(navigator.vibrate) navigator.vibrate(40);
      openRemote(s.id, slot.id);
    }, 650);
  }

  el.addEventListener("pointerdown", (e)=>{
    if(e.target.closest(".remoteBtn")) return;
    startPress(e.clientX, e.clientY);
  });

  el.addEventListener("pointermove", (e)=>{
    const dx = Math.abs(e.clientX - sx);
    const dy = Math.abs(e.clientY - sy);
    if(dx > 22 || dy > 22){
      clearPress();
    }
  });

  el.addEventListener("pointerup", (e)=>{
    if(e.target.closest(".remoteBtn")) return;

    clearPress();

    if(fired){
      e.preventDefault();
      e.stopPropagation();
      return;
    }

    useSlot(s.id, slot.id);
  });

  el.addEventListener("pointercancel", clearPress);
  el.addEventListener("pointerleave", clearPress);

  el.addEventListener("contextmenu", (e)=>{
    e.preventDefault();
  });

  return el;
}

function esc(x){
  return String(x||"").replace(/[&<>"]/g, m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[m]));
}

function getSlot(sheetId, slotId){
  const s = state.sheets.find(x=>x.id===sheetId);
  return s.slots.find(x=>x.id===slotId);
}

function useSlot(sheetId, slotId){
  const slot = getSlot(sheetId, slotId);

  if(slot.enabled === false){
    toast("Slot นี้ปิดอยู่");
    return;
  }

  if(slot.link_url){
    location.href = slot.link_url;
    return;
  }

  if(slot.media_url){
    openViewer(slot);
    return;
  }

  openRemote(sheetId, slotId);
}

function openRemote(sheetId, slotId){
  selected = {sheetId, slotId};
  const s = state.sheets.find(x=>x.id===sheetId);
  const slot = getSlot(sheetId, slotId);

  $("meta").textContent = `${s.title} / ${slot.title}`;
  $("fTitle").value = slot.title || "";
  $("fSubtitle").value = slot.subtitle || "";
  $("fKind").value = slot.kind || "action";
  $("fLink").value = slot.link_url || "";
  $("fEnabled").checked = slot.enabled !== false;
  $("fFile").value = "";

  showPreview(slot);
  $("back").classList.add("show");
  $("drawer").classList.add("show");
}

function closeRemote(){
  $("back").classList.remove("show");
  $("drawer").classList.remove("show");
}

function showPreview(slot){
  const p = $("preview");
  if(slot.media_url && slot.media_type === "video"){
    p.innerHTML = `<video src="${slot.media_url}" controls playsinline></video>`;
  }else if(slot.media_url){
    p.innerHTML = `<img src="${slot.media_url}">`;
  }else{
    p.textContent = "ยังไม่มีสื่อ";
  }
}

async function saveSlot(){
  state = await api(`/api/sheets/${selected.sheetId}/slots/${selected.slotId}`, {
    method:"PATCH",
    body:JSON.stringify({
      title:$("fTitle").value,
      subtitle:$("fSubtitle").value,
      kind:$("fKind").value,
      link_url:$("fLink").value,
      enabled:$("fEnabled").checked
    })
  });
  toast("บันทึกแล้ว");
  render();
  showPreview(getSlot(selected.sheetId, selected.slotId));
}

async function uploadFile(){
  const file = $("fFile").files[0];
  if(!file){
    toast("เลือกรูปหรือวิดีโอก่อน");
    return;
  }

  const fd = new FormData();
  fd.append("file", file);

  const res = await fetch(`/api/sheets/${selected.sheetId}/slots/${selected.slotId}/upload`, {
    method:"POST",
    body:fd
  });

  if(!res.ok){
    toast("อัปโหลดไม่สำเร็จ");
    return;
  }

  state = await res.json();
  toast("อัปโหลดแล้ว");
  render();
  showPreview(getSlot(selected.sheetId, selected.slotId));
}

async function clearMedia(){
  state = await api(`/api/sheets/${selected.sheetId}/slots/${selected.slotId}`, {
    method:"PATCH",
    body:JSON.stringify({media_url:"", media_type:""})
  });
  toast("ล้างสื่อแล้ว");
  render();
  showPreview(getSlot(selected.sheetId, selected.slotId));
}

async function deleteSlot(){
  if(!confirm("ลบ Slot นี้ใช่ไหม")) return;

  state = await api(`/api/sheets/${selected.sheetId}/slots/${selected.slotId}`, {
    method:"DELETE"
  });
  closeRemote();
  toast("ลบแล้ว");
  render();
}

async function addSheet(){
  const title = prompt("ชื่อแผ่นใหม่", "New Sheet");
  if(title === null) return;

  state = await api("/api/sheets", {
    method:"POST",
    body:JSON.stringify({title:title})
  });
  activeSheetId = state.settings.active_sheet;
  toast("เพิ่มแผ่นแล้ว");
  render();
}

async function addSlot(){
  const title = prompt("ชื่อ Slot ใหม่", "New Slot");
  if(title === null) return;

  state = await api(`/api/sheets/${activeSheetId}/slots`, {
    method:"POST",
    body:JSON.stringify({title:title, kind:"action"})
  });
  toast("เพิ่ม Slot แล้ว");
  render();
}

async function copySheet(){
  state = await api(`/api/sheets/${activeSheetId}/duplicate`, {
    method:"POST",
    body:"{}"
  });
  activeSheetId = state.settings.active_sheet;
  toast("คัดลอกแผ่นแล้ว");
  render();
}

function openViewer(slot){
  const b = $("viewerBody");
  b.innerHTML = slot.media_type === "video"
    ? `<video src="${slot.media_url}" controls autoplay playsinline></video>`
    : `<img src="${slot.media_url}">`;
  $("viewer").classList.add("show");
}

function closeViewer(){
  $("viewer").classList.remove("show");
}

$("addSheetBtn").addEventListener("click", addSheet);
$("addSlotBtn").addEventListener("click", addSlot);
$("copySheetBtn").addEventListener("click", copySheet);
$("shareBtn").addEventListener("click", async ()=>{
  try{
    await navigator.clipboard.writeText(location.href);
    toast("คัดลอกลิงก์แล้ว");
  }catch(e){
    prompt("Copy link", location.href);
  }
});
$("back").addEventListener("click", closeRemote);
$("closeBtn").addEventListener("click", closeRemote);
$("saveBtn").addEventListener("click", saveSlot);
$("uploadBtn").addEventListener("click", uploadFile);
$("clearBtn").addEventListener("click", clearMedia);
$("deleteBtn").addEventListener("click", deleteSlot);
$("closeViewerBtn").addEventListener("click", closeViewer);
$("viewer").addEventListener("click", e=>{
  if(e.target.id === "viewer") closeViewer();
});

load().catch(e=>{
  console.error(e);
  toast("โหลดผิดพลาด");
});
</script>
</body>
</html>
"""


def simple_page(title, desc):
    return f"""
<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<style>
body{{margin:0;min-height:100vh;background:radial-gradient(circle at top,#2b1304,#050302 48%,#000);color:#fff7ef;font-family:system-ui;padding:18px}}
.card{{max-width:720px;margin:30px auto;border:1px solid rgba(255,133,0,.35);border-radius:28px;background:rgba(18,9,5,.75);padding:22px;box-shadow:0 20px 60px rgba(0,0,0,.4)}}
h1{{margin:0 0 10px;font-size:32px}}
p{{color:#ffd7ad;line-height:1.55}}
a{{display:inline-block;margin-top:16px;background:linear-gradient(135deg,#ffb000,#ff8500);color:#190700;text-decoration:none;border-radius:16px;padding:12px 16px;font-weight:900}}

.remoteBtn{
  position:absolute;
  top:9px;
  right:9px;
  z-index:5;
  border:1px solid rgba(255,176,0,.55);
  background:rgba(0,0,0,.62);
  color:#ffb000;
  border-radius:999px;
  width:38px;
  height:38px;
  font-size:18px;
  font-weight:900;
}

</style>
</head>
<body>
<div class="card">
<h1>{title}</h1>
<p>{desc}</p>
<a href="/">← กลับ Remote</a>
</div>
</body>
</html>
"""


