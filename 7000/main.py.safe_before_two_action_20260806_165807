async def zone_auto_header_upload(zone_key: str, file: _AZUploadFile = _AZFile(...)):
    if zone_key not in _AZ_INFO:
        return _AZRedirectResponse("/zone-hub", status_code=303)

    _az_init()
    ext = _AZPath(file.filename or "header.jpg").suffix.lower()
    if ext not in {".jpg", ".jpeg", ".png", ".webp"}:
        return _AZRedirectResponse(f"/zone/{zone_key}", status_code=303)

    raw = await file.read()
    if not raw or len(raw) > 15 * 1024 * 1024:
        return _AZRedirectResponse(f"/zone/{zone_key}", status_code=303)

    for old in _AZ_HEADER_DIR.glob(f"{zone_key}.*"):
        try:
            old.unlink()
        except Exception:
            pass

    out = _AZ_HEADER_DIR / f"{zone_key}{ext}"
    out.write_bytes(raw)
    return _AZRedirectResponse(f"/zone/{zone_key}", status_code=303)

@app.get("/zone-auto/{zone_key}/header-image")
def zone_auto_header_image(zone_key: str):
    if zone_key not in _AZ_INFO:
        return _AZResponse(status_code=404)
    name = _az_latest_header(zone_key)
    if not name:
        return _AZResponse(status_code=404)
    target = _AZ_HEADER_DIR / name
    if target.exists():
        return _AZFileResponse(target, headers={"Cache-Control":"no-store, no-cache, must-revalidate, max-age=0"})
    return _AZResponse(status_code=404)

