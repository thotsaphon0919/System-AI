def ensure_room_page(page_id: str):
    st = load_state()
    pages = st.get("pages", [])
    page = next((p for p in pages if p.get("id") == page_id), None)
    if not page:
        raise HTTPException(status_code=404, detail="page not found")

    page.setdefault("items", [])
    while len(page["items"]) < 6:
        n = len(page["items"]) + 1
        page["items"].append({
