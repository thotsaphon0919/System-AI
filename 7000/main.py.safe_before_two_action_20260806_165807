import json as _CMJson
import uuid as _CMUuid
import re as _CMRe
from datetime import datetime as _CMDatetime
from fastapi import Form as _CMForm
from fastapi.responses import HTMLResponse as _CMHTMLResponse, RedirectResponse as _CMRedirectResponse

_CM_DIR = _CMPath("data/ai_chat_memory")
_CM_DB = _CM_DIR / "memory.json"
_CM_CHAT = _CM_DIR / "chat.json"

def _cm_init():
    _CM_DIR.mkdir(parents=True, exist_ok=True)
    if not _CM_DB.exists():
        _CM_DB.write_text(_CMJson.dumps({"items": []}, ensure_ascii=False, indent=2), encoding="utf-8")
    if not _CM_CHAT.exists():
        _CM_CHAT.write_text(_CMJson.dumps({"messages": []}, ensure_ascii=False, indent=2), encoding="utf-8")

def _cm_load(path, fallback):
    _cm_init()
    try:
        return _CMJson.loads(_CMPath(path).read_text(encoding="utf-8"))
    except Exception:
        return fallback

def _cm_save(path, data):
    _cm_init()
    _CMPath(path).write_text(_CMJson.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")

def _cm_now():
    return _CMDatetime.now().strftime("%Y-%m-%d %H:%M:%S")

def _cm_norm(t):
    return (t or "").strip().lower()

def _cm_tokens(t):
    t = _cm_norm(t)
    t = _CMRe.sub(r"[^\wก-๙]+", " ", t)
    return [x for x in t.split() if len(x) >= 2]

def _cm_extract_save(text):
    raw = (text or "").strip()
    patterns = [
        r"^จำไว้ว่า\s*(.+)$",
        r"^จำว่า\s*(.+)$",
        r"^บันทึกว่า\s*(.+)$",
        r"^remember that\s*(.+)$",
        r"^remember\s*(.+)$",
    ]
    for pat in patterns:
        m = _CMRe.search(pat, raw, flags=_CMRe.I)
        if m:
            content = m.group(1).strip()
            if "คือ" in content:
                key, value = content.split("คือ", 1)
                return key.strip(), value.strip(), content
            if "=" in content:
                key, value = content.split("=", 1)
                return key.strip(), value.strip(), content
            return content[:60].strip(), content, content
    return None

def _cm_search_memory(query):
    data = _cm_load(_CM_DB, {"items": []})
    items = data.get("items", [])
    q = _cm_norm(query)
    qtokens = _cm_tokens(q)

    scored = []
    for it in items:
        key = _cm_norm(it.get("key", ""))
        value = _cm_norm(it.get("value", ""))
        category = _cm_norm(it.get("category", ""))
        blob = f"{key} {value} {category}"

        score = 0
        if q and q in key:
            score += 10
        if q and q in value:
            score += 5
        for tok in qtokens:
            if tok in key:
                score += 4
            if tok in value:
                score += 2
            if tok in category:
                score += 1

        if score > 0:
            scored.append((score, it))

    scored.sort(key=lambda x: x[0], reverse=True)
    return [it for score, it in scored[:5]]

def _cm_add_memory(key, value, category="ความรู้", source="chat"):
    data = _cm_load(_CM_DB, {"items": []})
    items = data.get("items", [])

    item = {
        "id": _CMUuid.uuid4().hex,
        "key": key.strip(),
        "value": value.strip(),
        "category": category.strip() or "ความรู้",
        "source": source,
        "created_at": _cm_now(),
        "updated_at": _cm_now(),
    }
    items.append(item)
    data["items"] = items
    _cm_save(_CM_DB, data)
    return item

def _cm_add_message(role, text):
    data = _cm_load(_CM_CHAT, {"messages": []})
    data.setdefault("messages", [])
    data["messages"].append({
        "id": _CMUuid.uuid4().hex,
        "role": role,
        "text": text,
        "created_at": _cm_now(),
    })
    data["messages"] = data["messages"][-80:]
    _cm_save(_CM_CHAT, data)

def _cm_answer(user_text):
    save_data = _cm_extract_save(user_text)

    if save_data:
        key, value, full = save_data
        item = _cm_add_memory(key, value, "ความรู้", "chat")
        return f"บันทึกแล้ว: {item['key']} = {item['value']}"

    found = _cm_search_memory(user_text)

