            }
        _ZDB.write_text(_ZJson.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")

def _z_load():
    _z_init()
    data = _ZJson.loads(_ZDB.read_text(encoding="utf-8"))
    for k in _ZONES2:
        data.setdefault("zones", {}).setdefault(k, {"scene": "", "slots": []})
        data["zones"][k].setdefault("scene", "")
        data["zones"][k].setdefault("slots", [])
        while len(data["zones"][k]["slots"]) < 12:
            i = len(data["zones"][k]["slots"]) + 1
            data["zones"][k]["slots"].append({"title": f"ช่อง {i}", "url": ""})
