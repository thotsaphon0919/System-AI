      t.style.cssText = "position:fixed;top:12px;left:50%;transform:translateX(-50%);z-index:999999;background:#160800;color:white;border:1px solid rgba(255,174,25,.7);border-radius:999px;padding:10px 14px;font:14px system-ui;font-weight:800;display:none";
