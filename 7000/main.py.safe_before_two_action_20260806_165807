from fastapi import Request as _GCERequest
from fastapi.responses import Response as _GCEResponse

_GCE_SCRIPT = r"""
<script>
(function(){
  if(window.__INFINI_GENERATED_CLICK_EDIT_FIX_V1__) return;
  window.__INFINI_GENERATED_CLICK_EDIT_FIX_V1__ = true;

  function isGeneratedCard(card){
    const t = (card.innerText || card.textContent || '').toLowerCase();
    return (
      t.includes('generated') ||
      t.includes('รูปที่สร้าง') ||
      t.includes('scene builder')
    );
  }

  function bindGeneratedCards(){
    const cards = Array.from(document.querySelectorAll('.card'));
    cards.forEach(card=>{
      if(card.dataset.gceBound === '1') return;
      if(!isGeneratedCard(card)) return;

      const img = card.querySelector('img');
      if(!img) return;

      card.dataset.gceBound = '1';
      img.style.cursor = 'pointer';
      card.style.cursor = 'pointer';

      card.addEventListener('click', function(e){
        const tag = (e.target.tagName || '').toLowerCase();

        // กดปุ่มเปลี่ยนชื่อ / ลบ / input ยังให้ทำงานเดิม
        if(['button','input','select','textarea','form'].includes(tag)){
          return;
        }

        e.preventDefault();
        e.stopPropagation();

        const src = img.getAttribute('src');
        if(!src) return;

        location.href = '/scene-builder?start_image=' + encodeURIComponent(src);
      }, true);
    });
  }

  bindGeneratedCards();
  setInterval(bindGeneratedCards, 800);
})();
</script>
"""

@app.middleware("http")
async def generated_click_edit_fix_middleware(request: _GCERequest, call_next):
    response = await call_next(request)

    try:
        if request.url.path != "/ai-library":
            return response

        ctype = response.headers.get("content-type", "")
        if "text/html" not in ctype:
            return response

        body = b""
        async for chunk in response.body_iterator:
            body += chunk

        text = body.decode("utf-8", errors="ignore")

        if "INFINI_GENERATED_CLICK_EDIT_FIX_V1" not in text:
            if "</body>" in text:
                text = text.replace("</body>", _GCE_SCRIPT + "\n</body>")
            else:
                text += _GCE_SCRIPT

        headers = dict(response.headers)
        headers.pop("content-length", None)

        return _GCEResponse(
            content=text,
            status_code=response.status_code,
            headers=headers,
            media_type="text/html"
        )
    except Exception:
        return response

