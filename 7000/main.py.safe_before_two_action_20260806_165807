def _ds_ext(filename):
    ext = _DSPath(filename or "image.jpg").suffix.lower()
    if ext not in {".jpg", ".jpeg", ".png", ".webp", ".gif"}:
        ext = ".jpg"
    return ext

async def _ds_save_file(file):
    if not file:
        return ""
    raw = await file.read()
    if not raw:
        return ""
    if len(raw) > 25 * 1024 * 1024:
        return ""
    ext = _ds_ext(file.filename)
    name = f"{_DSUuid.uuid4().hex}{ext}"
    out = _DS_UPLOADS / name
    out.write_bytes(raw)
    return f"/ai-design-system/file/{name}"

