_LSB_UPLOADS.mkdir(parents=True, exist_ok=True)


def _lsb_load():
    try:
        if _LSB_DB.exists():
            data = _LSBJson.loads(_LSB_DB.read_text(encoding="utf-8"))
            if "items" in data:
                return data
    except Exception:
        pass
    return {"items": []}


def _lsb_save(data):
    _LSB_DB.write_text(_LSBJson.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")


def _lsb_ext(filename):
    ext = _LSBPath(filename or "image.jpg").suffix.lower()
    if ext not in {".jpg", ".jpeg", ".png", ".webp", ".gif"}:
        ext = ".jpg"
    return ext


def _lsb_esc(x):
    return str(x or "").replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace('"', "&quot;")


async def _lsb_save_upload(file, kind):
    if not file:
        return None

    raw = await file.read()
    if not raw:
        return None

    if len(raw) > 30 * 1024 * 1024:
        return None

    ext = _lsb_ext(file.filename)
    stored = kind + "_" + _LSBUuid.uuid4().hex + ext
    out = _LSB_UPLOADS / stored
    out.write_bytes(raw)

    return {
        "id": "img_" + _LSBUuid.uuid4().hex[:12],
        "kind": kind,
        "title": file.filename or stored,
        "stored": stored,
        "url": "/ai-library/file/" + stored,
        "created_at": int(_LSBTime.time()),
    }


def _lsb_items(kind=None):
    data = _lsb_load()
    items = data.get("items", [])
    if kind:
        return [x for x in items if x.get("kind") == kind]
    return items


