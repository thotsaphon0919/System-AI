  }

  async function getPages(){
    const r = await fetch("/api/state");
    const st = await r.json();
    return st.pages || [];
  }

  function uploadForPage(pg){
    const inp = document.createElement("input");
    inp.type = "file";
    inp.accept = "image/*,video/*";
    inp.style.display = "none";
    document.body.appendChild(inp);

    inp.onchange = async ()=>{
      const f = inp.files && inp.files[0];
      if(!f) return;

      const fd = new FormData();
      fd.append("file", f);

      toast("กำลังอัปโหลด...");
      const res = await fetch("/api/pages/" + pg.id + "/upload", {
        method:"POST",
        body:fd
      });

      if(!res.ok){
        toast("อัปโหลดไม่สำเร็จ");
        return;
      }

      toast("อัปโหลดแล้ว");
      setTimeout(()=>location.reload(),500);
    };

    inp.click();
  }

  function findCardFromGear(gear){
    let el = gear.parentElement;
    while(el && el !== document.body){
      const r = el.getBoundingClientRect();
      if(r.width > 90 && r.height > 90){
        return el;
      }
      el = el.parentElement;
    }
    return null;
  }

  function removeChangeButtons(){
    document.querySelectorAll(".crTopUpload,.tmChange,.topHeroChange").forEach(btn=>{
      btn.remove();
    });

    Array.from(document.querySelectorAll("button")).forEach(btn=>{
      const txt = (btn.textContent || "").trim();
      if(txt.includes("เปลี่ยนสื่อ")){
        btn.remove();
      }
    });
  }

  async function bind(){
    removeChangeButtons();

    const pages = await getPages();
    if(!pages.length) return;

    // เฟืองบน CREATIVE ROOM ด้านบน = เข้า room ช่องแรก
    document.querySelectorAll("#crTop .crTopGear, #topHeroWrap .topHeroGear, .topHeroGear").forEach(g=>{
      g.addEventListener("click", e=>{
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        location.href = "/subpages/" + pages[0].id;
        return false;
      }, true);
    });

    // ช่องเล็กทั้งหมดด้านล่าง
    const allGears = Array.from(document.querySelectorAll(".gear,button.gear,[class*='gear']"))
      .filter(g => !g.closest("#crTop") && !g.closest("#topHeroWrap") && !g.closest(".drawer"));

    const cards = [];
    allGears.forEach(g=>{
      const card = findCardFromGear(g);
      if(card && !cards.includes(card)) cards.push(card);
    });

    cards.forEach((card, idx)=>{
      const pg = pages[idx];
      if(!pg || !pg.id) return;

      const gear = card.querySelector(".gear,button.gear,[class*='gear']");
      if(gear){
        gear.addEventListener("click", e=>{
          e.preventDefault();
          e.stopPropagation();
