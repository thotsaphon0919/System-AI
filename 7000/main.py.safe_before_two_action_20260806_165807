        color:white;
        border:1px solid rgba(255,174,25,.18);
      }
      .crTopHeader{
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:12px;
        margin-bottom:18px;
      }
      #crTop h1{
        margin:0;
        font-size:46px;
        line-height:.95;
        letter-spacing:.02em;
        font-weight:1000;
        color:white;
      }
      .crIdBtn{
        flex:0 0 auto;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        min-height:46px;
        padding:10px 14px;
        border:1px solid rgba(255,174,25,.7);
        border-radius:16px;
        background:rgba(0,0,0,.68);
        color:#ffd39a;
        text-decoration:none;
        font-size:15px;
        font-weight:1000;
      }
      .crIdBtn:active{transform:scale(.97)}
      .crMediaBox{
        position:relative;
        width:100%;
        aspect-ratio:2/3;
        background:#120900;
        overflow:hidden;
        border-radius:8px;
