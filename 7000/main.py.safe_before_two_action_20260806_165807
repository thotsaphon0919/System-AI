import uuid as _ALLUuid
import json as _ALLJson
from typing import List as _ALLList, Optional as _ALLOptional
from fastapi import UploadFile as _ALLUploadFile, File as _ALLFile, Form as _ALLForm
from fastapi.responses import HTMLResponse as _ALLHTMLResponse, FileResponse as _ALLFileResponse
from starlette.responses import Response as _ALLResponse

_ALL_DIR = _ALLPath("data/ai_layout_lab")
_ALL_UPLOADS = _ALL_DIR / "uploads"
_ALL_RESULT = _ALL_DIR / "last_result.json"

def _all_init():
    _ALL_UPLOADS.mkdir(parents=True, exist_ok=True)
    if not _ALL_RESULT.exists():
        _ALL_RESULT.write_text(_ALLJson.dumps({"result": None}, ensure_ascii=False, indent=2), encoding="utf-8")

def _all_safe_ext(name):
    ext = _ALLPath(name or "image.jpg").suffix.lower()
    if ext not in {".jpg", ".jpeg", ".png", ".webp"}:
        ext = ".jpg"
    return ext

async def _all_save_upload(file):
    if not file:
        return ""
    raw = await file.read()
    if not raw:
        return ""
    if len(raw) > 20 * 1024 * 1024:
        return ""
    ext = _all_safe_ext(file.filename)
    name = f"{_ALLUuid.uuid4().hex}{ext}"
    out = _ALL_UPLOADS / name
    out.write_bytes(raw)
    return f"/ai-layout-lab/file/{name}"

def _all_load_result():
    _all_init()
    try:
        return _ALLJson.loads(_ALL_RESULT.read_text(encoding="utf-8")).get("result")
    except Exception:
        return None

