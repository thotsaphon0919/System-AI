@app.post("/market-pipe/order")
def goodrich_market_pipe_create_order(
    product_id: str = _GRForm(...),
    customer_name: str = _GRForm(""),
    contact: str = _GRForm(""),
    message: str = _GRForm(""),
    action: str = _GRForm("reserve")
):
    _gr_seed()

    products_data = _gr_load(_GR_PRODUCTS, {"items": []})
    product = None

    for item in products_data.get("items", []):
        if item.get("id") == product_id:
            product = item
            break

    if not product:
        return _GRJSONResponse({"ok": False, "error": "ไม่พบสินค้า"}, status_code=404)

    if product.get("status") != "พร้อมขาย":
        return _GRJSONResponse({"ok": False, "error": "สินค้านี้ไม่พร้อมขายแล้ว"}, status_code=400)

    if action == "buy":
        new_status = "ขายแล้ว"
        action_label = "ซื้อสินค้า"
    else:
        new_status = "จองแล้ว"
        action_label = "จองสินค้า"

    product["status"] = new_status
    _gr_save(_GR_PRODUCTS, products_data)

    order = {
        "id": "order_" + _gr_uuid.uuid4().hex[:10],
        "created_at": _gr_now(),
        "product_id": product_id,
        "product_name": product.get("name", ""),
        "price": product.get("price", ""),
        "customer_name": customer_name.strip() or "ไม่ระบุชื่อ",
        "contact": contact.strip(),
        "message": message.strip(),
        "action": action,
        "action_label": action_label,
        "status": new_status
    }

    orders = _gr_load(_GR_ORDERS, {"items": []})
    orders.setdefault("items", []).append(order)
    _gr_save(_GR_ORDERS, orders)

    event = {
        "time": _gr_now(),
        "type": "order",
        "text": f"{action_label}: {product.get('name','สินค้า')} โดย {order['customer_name']} สถานะ {new_status}",
        "order_id": order["id"],
        "product_id": product_id
    }

    _gr_rebuild_room(event)

    return _GRHTMLResponse(f"""
    <html>
    <head>
        <meta charset="utf-8">
        <meta http-equiv="refresh" content="1;url=/market-pipe">
        <title>บันทึกแล้ว</title>
    </head>
    <body style="background:#111;color:#fff;font-family:system-ui;padding:30px">
        <h2>บันทึก {action_label} แล้ว</h2>
        <p>กำลังกลับไปหน้า Market Pipe...</p>
        <a style="color:#ffb04a" href="/market-pipe">กลับทันที</a>
    </body>
    </html>
    """)

