    title: str = _UKForm(""),
    category: str = _UKForm("ทั่วไป"),
    trigger_words: str = _UKForm(""),
    text_content: str = _UKForm(""),
    files: _UKList[_UKUploadFile] = _UKFile(default=[]),
):
    added = 0

    if text_content.strip():
        chunks = _uk_split_chunks(text_content)
        for i, ch in enumerate(chunks, 1):
            chunk_title = title.strip() or category
            if len(chunks) > 1:
                chunk_title = f"{chunk_title} #{i}"
            _uk_add_item(knowledge_type, chunk_title, category, trigger_words, ch, "paste")
            added += 1

    for f in files[:20]:
        txt = await _uk_read_file_text(f)
        if txt.strip():
            chunks = _uk_split_chunks(txt)
            for i, ch in enumerate(chunks, 1):
                base = title.strip() or (f.filename or "uploaded knowledge")
                chunk_title = base if len(chunks) == 1 else f"{base} #{i}"
                _uk_add_item(knowledge_type, chunk_title, category, trigger_words, ch, f.filename or "file")
                added += 1

    return _UKRedirectResponse("/ai-knowledge-master", status_code=303)

