def _pm_style_options(selected=""):
    styles = _pm_style_data()
    html = ""
    for key, st in styles.items():
        name = st.get("name", key)
        sel = "selected" if name == selected else ""
        html += f'<option value="{name}" {sel}>{name}</option>'
    return html

def _pm_knowledge_options(selected_ids=None):
    selected_ids = selected_ids or []
    items = _pm_load_knowledge()
    if not items:
        return '<option value="">ยังไม่มีความรู้ใน Knowledge Studio</option>'
    html = ""
    for it in items[-80:]:
        kid = it.get("id", "")
        title = it.get("title", "Untitled")
        style = it.get("style", "")
        domain = it.get("domain", "")
        sel = "selected" if kid in selected_ids else ""
        html += f'<option value="{kid}" {sel}>{title} | {style} | {domain}</option>'
    return html

def _pm_find_style(style_name):
    for key, st in _pm_style_data().items():
        if st.get("name") == style_name or key == style_name:
            return st
    return {}

def _pm_find_knowledge(ids):
    items = _pm_load_knowledge()
    found = []
    for it in items:
        if it.get("id") in ids:
            found.append(it)
    return found

def _pm_build_prompt(goal, style_name, main_color, domain, layout_type, selected_ids, extra_order):
    style = _pm_find_style(style_name)
    know = _pm_find_knowledge(selected_ids)

    style_prompt = style.get("prompt", "")
    style_rules = style.get("rules", [])

    remember_lines = []
    good_lines = []
    bad_lines = []
    example_lines = []

    for it in know:
        title = it.get("title", "")
        remember = it.get("remember", "")
        good = it.get("good", "")
        bad = it.get("bad", "")
        desc = it.get("description", "")
        if title or desc:
            example_lines.append(f"- {title}: {desc}")
        if remember:
            remember_lines.append(f"- {remember}")
        if good:
            good_lines.append(f"- {good}")
        if bad:
            bad_lines.append(f"- {bad}")

    if not remember_lines:
        remember_lines.append("- ใช้กฎออกแบบกลางของ INFINI: สินค้าต้องเด่น อ่านง่าย ไม่รก ตัวหนังสือห้ามบังของหลัก")
    if not bad_lines:
