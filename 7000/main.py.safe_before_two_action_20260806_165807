from pathlib import Path as _UKPath
import json as _UKJson
import uuid as _UKUuid
import re as _UKRe
import html as _UKHtml
from datetime import datetime as _UKDatetime
from typing import List as _UKList
from fastapi import UploadFile as _UKUploadFile, File as _UKFile, Form as _UKForm
from fastapi.responses import HTMLResponse as _UKHTMLResponse, RedirectResponse as _UKRedirectResponse

_UK_DIR = _UKPath("data/infini_unified_knowledge")
_UK_DB = _UK_DIR / "knowledge_master.json"

def _uk_init():
    _UK_DIR.mkdir(parents=True, exist_ok=True)
    if not _UK_DB.exists():
        _UK_DB.write_text(_UKJson.dumps({"items": []}, ensure_ascii=False, indent=2), encoding="utf-8")

def _uk_now():
    return _UKDatetime.now().strftime("%Y-%m-%d %H:%M:%S")

def _uk_load():
    _uk_init()
    try:
        return _UKJson.loads(_UK_DB.read_text(encoding="utf-8"))
    except Exception:
        return {"items": []}

def _uk_save(data):
    _uk_init()
    _UK_DB.write_text(_UKJson.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")

def _uk_norm(t):
    return (t or "").strip().lower()

def _uk_tokens(t):
    t = _uk_norm(t)
    t = _UKRe.sub(r"[^\wก-๙]+", " ", t)
    return [x for x in t.split() if len(x) >= 2]

async def _uk_read_file_text(file):
    if not file:
        return ""
    raw = await file.read()
    if not raw:
        return ""
    if len(raw) > 3 * 1024 * 1024:
        raw = raw[:3 * 1024 * 1024]
    try:
        return raw.decode("utf-8")
    except Exception:
        return raw.decode("utf-8", errors="ignore")

def _uk_split_chunks(text):
    text = (text or "").strip()
    if not text:
        return []
    parts = []
    for block in _UKRe.split(r"\n\s*\n", text):
        block = block.strip()
        if not block:
            continue
        if len(block) <= 900:
            parts.append(block)
        else:
            lines = [x.strip() for x in block.splitlines() if x.strip()]
            buf = ""
            for line in lines:
                if len(buf) + len(line) > 900:
                    if buf.strip():
                        parts.append(buf.strip())
                    buf = line
                else:
                    buf += ("\n" if buf else "") + line
            if buf.strip():
                parts.append(buf.strip())
    return parts[:200]

def _uk_add_item(knowledge_type, title, category, trigger_words, content, source="manual"):
    data = _uk_load()
    data.setdefault("items", [])
    item = {
        "id": _UKUuid.uuid4().hex,
        "knowledge_type": knowledge_type,
        "title": title.strip() or "Untitled",
        "category": category.strip() or "ทั่วไป",
        "trigger_words": trigger_words.strip(),
        "content": content.strip(),
        "source": source,
        "created_at": _uk_now(),
        "updated_at": _uk_now(),
    }
    data["items"].append(item)
    _uk_save(data)
    return item

def _uk_search(query, knowledge_type=None, limit=6):
    data = _uk_load()
    items = data.get("items", [])
    q = _uk_norm(query)
    toks = _uk_tokens(q)

    scored = []
    for it in items:
        if knowledge_type and it.get("knowledge_type") != knowledge_type:
            continue

        title = _uk_norm(it.get("title", ""))
        cat = _uk_norm(it.get("category", ""))
        trig = _uk_norm(it.get("trigger_words", ""))
        content = _uk_norm(it.get("content", ""))
        blob = f"{title} {cat} {trig} {content}"

        score = 0
        if q and q in title:
            score += 12
        if q and q in trig:
            score += 10
        if q and q in content:
            score += 5
        for tok in toks:
            if tok in title:
                score += 5
            if tok in trig:
                score += 5
            if tok in cat:
                score += 3
            if tok in content:
                score += 2

        if score > 0:
            scored.append((score, it))

    scored.sort(key=lambda x: x[0], reverse=True)
    return [it for score, it in scored[:limit]]

def _uk_items_html(kind):
    data = _uk_load()
    items = [x for x in data.get("items", []) if x.get("knowledge_type") == kind]
    if not items:
