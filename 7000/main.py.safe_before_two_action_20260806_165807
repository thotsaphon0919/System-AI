# === INFINI_PRODUCT_POSTER_SHEET_V1 ===
# สร้างแผ่นสินค้าแบบโปสเตอร์ / catalog sheet คล้าย reference:
# รูปสินค้าใหญ่ + จุดขาย + กล่องรายละเอียด + รูปย่อย + footer
def _core_file_path_from_url_v2(url):
    try:
        name = str(url or "").split("/")[-1].split("?")[0]
        safe = _CorePath(name).name
        path = _CORE_UPLOADS / safe
        if path.exists():
            return path
    except Exception:
        pass
    return None


def _poster_fit_cover(img, size):
    from PIL import Image
    img = img.convert("RGB")
    w, h = img.size
    tw, th = size
    scale = max(tw / w, th / h)
    nw, nh = int(w * scale), int(h * scale)
    img = img.resize((nw, nh), Image.LANCZOS)
    x = max(0, (nw - tw) // 2)
    y = max(0, (nh - th) // 2)
    return img.crop((x, y, x + tw, y + th))


def _poster_fit_contain(img, size):
    from PIL import Image
    img = img.convert("RGBA")
    w, h = img.size
    tw, th = size
    scale = min(tw / w, th / h)
    nw, nh = int(w * scale), int(h * scale)
    return img.resize((nw, nh), Image.LANCZOS)


def _poster_cut_white_bg(img):
    img = img.convert("RGBA")
    px = img.load()
    w, h = img.size

    # ตัดฉากขาวแบบง่าย เหมาะกับรูปสินค้า background ขาว
    for y in range(h):
        for x in range(w):
            r, g, b, a = px[x, y]
            if r > 232 and g > 232 and b > 232:
                px[x, y] = (255, 255, 255, 0)
            elif r > 245 and g > 245 and b > 238:
                px[x, y] = (255, 255, 255, 0)

    return img


def _poster_text(draw, pos, text, font, fill):
    try:
        draw.text(pos, str(text or ""), font=font, fill=fill)
    except Exception:
        draw.text(pos, str(text or ""), fill=fill)


def _poster_load_fonts():
    from PIL import ImageFont
    try:
        big = ImageFont.truetype("DejaVuSans-Bold.ttf", 72)
        mid = ImageFont.truetype("DejaVuSans-Bold.ttf", 38)
        small = ImageFont.truetype("DejaVuSans.ttf", 26)
        tiny = ImageFont.truetype("DejaVuSans.ttf", 21)
    except Exception:
        big = mid = small = tiny = None
    return big, mid, small, tiny


def _core_render_product_poster_sheet(product_file=None, selected_scene=None, pattern="product", goal="", extra_note=""):
    try:
        from PIL import Image, ImageDraw, ImageFilter
    except Exception:
        return None

    product_path = _core_file_path_from_url_v2((product_file or {}).get("url"))
    scene_path = _core_file_path_from_url_v2((selected_scene or {}).get("url"))

    if not product_path:
        return None

    W, H = 1100, 1450
    canvas = Image.new("RGBA", (W, H), (5, 5, 5, 255))
    draw = ImageDraw.Draw(canvas, "RGBA")

    # background
    if scene_path:
        bg = Image.open(scene_path)
        bg = _poster_fit_cover(bg, (W, H)).convert("RGBA")
        bg = bg.filter(ImageFilter.GaussianBlur(2))
        canvas.alpha_composite(bg)
        canvas.alpha_composite(Image.new("RGBA", (W, H), (0, 0, 0, 150)))
    else:
        # gradient-like dark panels
        draw.rectangle((0, 0, W, H), fill=(6, 6, 6, 255))
        draw.ellipse((-300, -260, 760, 720), fill=(45, 18, 5, 80))
        draw.ellipse((520, 220, 1450, 1200), fill=(16, 35, 45, 60))

    orange = (255, 145, 34, 255)
    line = (255, 145, 34, 150)
    white = (245, 245, 245, 255)
    muted = (205, 195, 185, 255)

    big, mid, small, tiny = _poster_load_fonts()

    # outer frame
    draw.rounded_rectangle((28, 28, W-28, H-28), radius=36, outline=line, width=3)

    # Header
    _poster_text(draw, (55, 55), "INFINI", big, white)
    _poster_text(draw, (62, 135), "PRODUCT PATCH SYSTEM", small, orange)

    title = (goal or "CUSTOM PRODUCT SHEET").strip()
    if len(title) > 36:
        title = title[:36] + "..."
    _poster_text(draw, (62, 178), title, small, muted)

    # Hero product area
    hero_box = (360, 95, 1040, 650)
    draw.rounded_rectangle(hero_box, radius=34, fill=(0,0,0,80), outline=(255,255,255,50), width=2)

    prod = Image.open(product_path).convert("RGBA")
    prod = _poster_cut_white_bg(prod)
    prod = _poster_fit_contain(prod, (620, 520))

    px = hero_box[0] + ((hero_box[2]-hero_box[0]) - prod.size[0]) // 2
    py = hero_box[1] + ((hero_box[3]-hero_box[1]) - prod.size[1]) // 2

    shadow = Image.new("RGBA", prod.size, (0,0,0,0))
    shadow.putalpha(prod.getchannel("A"))
    shadow = shadow.filter(ImageFilter.GaussianBlur(22))
    canvas.alpha_composite(shadow, (px+25, py+30))
    canvas.alpha_composite(prod, (px, py))

    # Left feature list
    features = [
        ("01", "เปลี่ยนภาพได้", "ใช้สินค้าใหม่ได้ในแต่ละรอบ"),
        ("02", "จัดเป็นแผ่นขาย", "พร้อมใช้ใน INFINI Space"),
        ("03", "อ่านง่าย", "ข้อความไม่บังสินค้า"),
        ("04", "เก็บเป็นระบบ", "ใช้ร่วมกับห้องความรู้"),
    ]
    y = 250
    for no, h, d in features:
        draw.ellipse((62, y, 120, y+58), outline=(255,255,255,100), width=2)
        _poster_text(draw, (80, y+14), no, tiny, orange)
        _poster_text(draw, (140, y+2), h, small, white)
        _poster_text(draw, (140, y+34), d, tiny, muted)
        y += 92

    # Middle strip
    strip_y = 690
    draw.rounded_rectangle((45, strip_y, W-45, strip_y+230), radius=24, outline=(255,255,255,70), fill=(0,0,0,125), width=2)

    # thumbnail blocks
    thumb_w = 235
    for i in range(4):
        x = 70 + i*(thumb_w+22)
        draw.rounded_rectangle((x, strip_y+28, x+thumb_w, strip_y+185), radius=18, fill=(15,15,15,220), outline=(255,255,255,50), width=1)
        thumb = _poster_fit_contain(prod, (thumb_w-30, 130))
        tx = x + (thumb_w - thumb.size[0])//2
