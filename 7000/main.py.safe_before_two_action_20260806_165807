        toast("อัปโหลดไม่สำเร็จ");
        return;
      }
      toast("เปลี่ยนสื่อช่องแล้ว");
      setTimeout(()=>location.reload(),500);
    };
    inp.click();
  }

  async function bindCards(){
    const st = await api("/api/state");
    const pages = st.pages || [];

    setTimeout(()=>{
      const cards = findCards();

      cards.forEach((card,idx)=>{
        const pg = pages[idx];
        if(!pg || !pg.id) return;

        const gear = card.querySelector(".gear,button.gear,[class*='gear']");
        if(gear){
          gear.addEventListener("click",e=>{
            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();
            uploadCard(pg);
            return false;
          },true);
        }

        card.addEventListener("click",e=>{
          if(e.target.closest(".gear,button.gear,[class*='gear']")) return;
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();
          location.href = "/subpages/" + pg.id;
          return false;
        },true);
      });
    },700);
  }

  buildTop().catch(e=>{console.error(e);toast("โหลด CREATIVE ROOM ไม่สำเร็จ")});
  bindCards().catch(e=>{console.error(e);toast("ผูกช่องเล็กไม่สำเร็จ")});
})();
