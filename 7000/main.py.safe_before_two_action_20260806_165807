  async function buildTop(){
    addCSS();
    if(document.getElementById("crTop")) return;

    const st = await api("/api/creative/top");

    const grid =
      document.querySelector(".grid") ||
      document.querySelector(".cards") ||
      document.querySelector("main") ||
      document.body.firstElementChild;

    const box = document.createElement("div");
    box.id = "crTop";
    box.innerHTML = `
      <div class="crTopHeader">
        <h1>CREATIVE ROOM</h1>
        <a class="crIdBtn" href="/id">ไปหน้า ID</a>
      </div>
      <div class="crMediaBox">
        ${mediaHtml(st)}
        <button class="crTopGear">⚙</button>
        <button class="crTopUpload">เปลี่ยนสื่อ</button>
      </div>
    `;

    if(grid && grid.parentNode){
      grid.parentNode.insertBefore(box, grid);
    }else{
      document.body.insertBefore(box, document.body.firstChild);
    }

    box.querySelector(".crTopGear").addEventListener("click",e=>{
      e.preventDefault();
      e.stopPropagation();
      uploadTop();
    });

    box.querySelector(".crTopUpload").addEventListener("click",e=>{
      e.preventDefault();
      e.stopPropagation();
      uploadTop();
    });
  }

  function findCards(){
    const gears = Array.from(document.querySelectorAll(".gear,button.gear,[class*='gear']"))
      .filter(g => !g.closest("#crTop") && !g.closest(".drawer") && !g.closest("[id^='__']"));

    const cards = [];
    gears.forEach(g=>{
      let el = g.parentElement;
      while(el && el !== document.body){
        const r = el.getBoundingClientRect();
        if(r.width > 90 && r.height > 90){
          if(!cards.includes(el)) cards.push(el);
          break;
        }
        el = el.parentElement;
      }
    });
    return cards;
  }

  function uploadCard(pg){
    const inp = document.createElement("input");
    inp.type = "file";
    inp.accept = "image/*,video/*";
    inp.style.display = "none";
