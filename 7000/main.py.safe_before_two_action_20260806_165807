      <script>
        const LIB = """ + items_json + """;
        let tab = 'product';
        let canvas = document.getElementById('c');
        let ctx = canvas.getContext('2d');
        let bg = null;
        let objects = [];
        let selected = null;
        let dragging = false;
        let dragMode = 'move';
        let last = {x:0,y:0};
        let startDist = 1;
        let startScale = 1;

        function setTab(t){
          tab=t;
          document.getElementById('tabProduct').classList.toggle('active',t==='product');
          document.getElementById('tabScene').classList.toggle('active',t==='scene');
          document.getElementById('tabGenerated').classList.toggle('active',t==='generated');
          renderAssets();
        }

        function renderAssets(){
          let q = (document.getElementById('search').value || '').toLowerCase();
          let grid = document.getElementById('assetGrid');
          grid.innerHTML = '';
          LIB.filter(x=>x.kind===tab)
             .filter(x=>(x.title||'').toLowerCase().includes(q))
             .forEach(item=>{
                let d=document.createElement('div');
                d.className='asset';
                d.innerHTML='<img src="'+item.url+'"><div>'+escapeHtml(item.title||'รูป')+'</div>';
                d.onclick=()=>useAsset(item);
                grid.appendChild(d);
             });
        }

        function escapeHtml(s){
          return String(s||'').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
        }

        function loadImg(src, cb){
          let img = new Image();
          img.crossOrigin = 'anonymous';
          img.onload = ()=>cb(img);
          img.src = src;
        }

        function useAsset(item){
          if(item.kind === 'scene' || tab === 'scene'){
            loadImg(item.url, img=>{bg=img; draw();});
          }else{
            loadImg(item.url, img=>{
              objects.push({img:img,x:canvas.width/2,y:canvas.height/2,scale:0.55,rot:0,w:img.width,h:img.height,removeBg:false});
              selected = objects[objects.length-1];
              fitToFrame();
              draw();
            });
          }
        }

        function loadLocalFile(ev){
          let file = ev.target.files[0];
          if(!file) return;
          let url = URL.createObjectURL(file);
          loadImg(url, img=>{
            if(tab === 'scene'){
              bg = img;
            }else{
              objects.push({img:img,x:canvas.width/2,y:canvas.height/2,scale:0.55,rot:0,w:img.width,h:img.height,removeBg:false});
              selected = objects[objects.length-1];
              fitToFrame();
            }
            draw();
          });
        }

        function coverImage(img, x,y,w,h){
          let scale = Math.max(w/img.width, h/img.height);
          let nw = img.width*scale, nh = img.height*scale;
          ctx.drawImage(img, x+(w-nw)/2, y+(h-nh)/2, nw, nh);
        }

        function draw(){
          ctx.clearRect(0,0,canvas.width,canvas.height);
          ctx.fillStyle = '#080604';
          ctx.fillRect(0,0,canvas.width,canvas.height);

          if(bg){
            coverImage(bg,0,0,canvas.width,canvas.height);
            ctx.fillStyle='rgba(0,0,0,.18)';
            ctx.fillRect(0,0,canvas.width,canvas.height);
          }

          ctx.strokeStyle='rgba(255,153,38,.75)';
          ctx.lineWidth=4;
          roundRect(25,25,canvas.width-50,canvas.height-50,34);
          ctx.stroke();

          for(let o of objects){
            ctx.save();
            ctx.translate(o.x,o.y);
            ctx.rotate(o.rot*Math.PI/180);
            let w=o.img.width*o.scale;
            let h=o.img.height*o.scale;
            ctx.drawImage(o.img,-w/2,-h/2,w,h);
            if(o===selected){
              ctx.strokeStyle='#ff9f22';
              ctx.lineWidth=4;
              ctx.strokeRect(-w/2,-h/2,w,h);

              ctx.fillStyle='#ff9f22';
              const hs = 34;
              const corners = [
                [-w/2,-h/2],[w/2,-h/2],
                [-w/2,h/2],[w/2,h/2]
              ];
              for(const c of corners){
                ctx.beginPath();
                ctx.arc(c[0], c[1], hs, 0, Math.PI*2);
                ctx.fill();
              }
            }
            ctx.restore();
          }
        }

        function roundRect(x,y,w,h,r){
          ctx.beginPath();
          ctx.moveTo(x+r,y);
          ctx.arcTo(x+w,y,x+w,y+h,r);
          ctx.arcTo(x+w,y+h,x,y+h,r);
          ctx.arcTo(x,y+h,x,y,r);
          ctx.arcTo(x,y,x+w,y,r);
          ctx.closePath();
        }

        function pointer(e){
          let r=canvas.getBoundingClientRect();
          let t=e.touches ? e.touches[0] : e;
          return {x:(t.clientX-r.left)*(canvas.width/r.width), y:(t.clientY-r.top)*(canvas.height/r.height)};
        }

        function hitTest(p){
          for(let i=objects.length-1;i>=0;i--){
            let o=objects[i];
            let w=o.img.width*o.scale, h=o.img.height*o.scale;
            if(p.x>o.x-w/2 && p.x<o.x+w/2 && p.y>o.y-h/2 && p.y<o.y+h/2) return o;
          }
          return null;
        }

        function nearCorner(p,o){
          if(!o) return false;
          let w=o.img.width*o.scale;
          let h=o.img.height*o.scale;
          let corners=[
            {x:o.x-w/2,y:o.y-h/2},
            {x:o.x+w/2,y:o.y-h/2},
            {x:o.x-w/2,y:o.y+h/2},
            {x:o.x+w/2,y:o.y+h/2}
          ];
          return corners.some(c=>{
            let dx=p.x-c.x, dy=p.y-c.y;
            return Math.sqrt(dx*dx+dy*dy) < 95;
          });
        }

        function distFromCenter(p,o){
          let dx=p.x-o.x, dy=p.y-o.y;
          return Math.max(1, Math.sqrt(dx*dx+dy*dy));
        }

        canvas.addEventListener('pointerdown', e=>{
          e.preventDefault();
          canvas.setPointerCapture && canvas.setPointerCapture(e.pointerId);

          let p=pointer(e);
          selected=hitTest(p);

          if(selected){
            dragging=true;
            last=p;

            if(nearCorner(p,selected)){
              dragMode='resize';
              startDist=distFromCenter(p,selected);
              startScale=selected.scale;
            }else{
              dragMode='move';
            }
          }else{
            dragging=false;
            dragMode='move';
            // แตะโดนพื้นที่ว่าง ไม่ล้าง selected ทิ้ง
            // เพื่อให้บนมือถือกรอบส้มไม่หายง่าย
          }

          draw();
        });

        canvas.addEventListener('pointermove', e=>{
          if(!dragging || !selected) return;
          e.preventDefault();

          let p=pointer(e);

          if(dragMode === 'resize'){
            let d = distFromCenter(p,selected);
            selected.scale = Math.max(0.03, Math.min(5, startScale * (d / startDist)));
          }else{
            selected.x += p.x-last.x;
            selected.y += p.y-last.y;
            last=p;
          }

          draw();
        });

        canvas.addEventListener('pointerup', e=>{
          dragging=false;
          dragMode='move';
          try{ canvas.releasePointerCapture && canvas.releasePointerCapture(e.pointerId); }catch(err){}
        });

        canvas.addEventListener('pointercancel', ()=>{
          dragging=false;
          dragMode='move';
        });

        function scaleSelected(k){
          if(!selected) return;
          selected.scale *= k;
          draw();
        }

        function rotateSelected(deg){
          if(!selected) return;
          selected.rot += deg;
          draw();
        }

        function fitToFrame(){
          if(!selected) return;
          let maxW = canvas.width * .62;
          let maxH = canvas.height * .48;
          selected.scale = Math.min(maxW/selected.img.width, maxH/selected.img.height);
          selected.x = canvas.width/2;
          selected.y = canvas.height/2;
          selected.rot = 0;
          draw();
        }

        function deleteSelected(){
          if(!selected) return;
          objects = objects.filter(o=>o!==selected);
          selected = null;
          draw();
        }

        function bringFront(){
          if(!selected) return;
          objects = objects.filter(o=>o!==selected);
          objects.push(selected);
          draw();
        }

        function sendBack(){
          if(!selected) return;
          objects = objects.filter(o=>o!==selected);
          objects.unshift(selected);
          draw();
        }

        function resetCanvas(){
          if(!confirm('ล้าง canvas นี้?')) return;
          bg=null; objects=[]; selected=null; draw();
        }

        function removeBg(){
          if(!selected){
            alert('แตะเลือกรูปสินค้าก่อน แล้วค่อยกด Remove Background');
            return;
          }

          const srcImg = selected.img;
          const w = srcImg.naturalWidth || srcImg.width;
          const h = srcImg.naturalHeight || srcImg.height;

          const t = document.createElement('canvas');
          t.width = w;
          t.height = h;
          const tx = t.getContext('2d', {willReadFrequently:true});
          tx.drawImage(srcImg, 0, 0, w, h);

          let imgData;
          try{
            imgData = tx.getImageData(0,0,w,h);
          }catch(e){
            alert('รูปนี้ตัดพื้นหลังไม่ได้ อาจติด cross-origin ให้ลองอัปโหลดจากเครื่องหรือใช้รูป PNG');
            return;
          }

          const d = imgData.data;

          function pix(x,y){
            const i = (y*w + x) * 4;
            return [d[i], d[i+1], d[i+2]];
          }

          const samples = [
            pix(2,2),
            pix(w-3,2),
            pix(2,h-3),
            pix(w-3,h-3),
            pix(Math.floor(w/2),2),
            pix(Math.floor(w/2),h-3),
            pix(2,Math.floor(h/2)),
            pix(w-3,Math.floor(h/2))
          ];

          let br=0,bg=0,bb=0;
          samples.forEach(c=>{
            br += c[0]; bg += c[1]; bb += c[2];
          });
          br /= samples.length;
          bg /= samples.length;
          bb /= samples.length;

          const tolerance = 58;

          for(let y=0;y<h;y++){
            for(let x=0;x<w;x++){
              const i = (y*w + x) * 4;
              const r = d[i], g = d[i+1], b = d[i+2];

              const dist = Math.sqrt(
                (r-br)*(r-br) +
                (g-bg)*(g-bg) +
                (b-bb)*(b-bb)
              );

              if(dist < tolerance){
                d[i+3] = 0;
              }else if(dist < tolerance + 28){
                d[i+3] = Math.max(0, Math.min(255, (dist - tolerance) * 9));
              }
            }
          }

          tx.putImageData(imgData,0,0);

          const out = new Image();
          out.onload = ()=>{
            selected.img = out;
            selected.w = out.width;
            selected.h = out.height;
            selected.removeBg = true;
            draw();
          };
          out.src = t.toDataURL('image/png');
        }

        function saveCanvas(){
          selected=null;
          draw();
          document.getElementById('imageData').value = canvas.toDataURL('image/png');
          document.getElementById('saveForm').submit();
        }

        window.setTab = setTab;
        window.renderAssets = renderAssets;
        window.loadLocalFile = loadLocalFile;
        window.useAsset = useAsset;
        window.scaleSelected = scaleSelected;
        window.rotateSelected = rotateSelected;
        window.fitToFrame = fitToFrame;
        window.deleteSelected = deleteSelected;
        window.bringFront = bringFront;
        window.sendBack = sendBack;
        window.resetCanvas = resetCanvas;
        window.removeBg = removeBg;
        window.saveCanvas = saveCanvas;

        function bindToolButtonsHard(){
          const buttons = Array.from(document.querySelectorAll('button'));
          buttons.forEach(btn=>{
            const t = (btn.innerText || btn.textContent || '').trim();

            if(btn.dataset.hardBound === '1') return;

            if(t === 'Remove Background'){
              btn.dataset.hardBound = '1';
              btn.addEventListener('click', function(e){ e.preventDefault(); removeBg(); }, true);
            }

            if(t === 'Fit to Frame'){
              btn.dataset.hardBound = '1';
              btn.addEventListener('click', function(e){ e.preventDefault(); fitToFrame(); }, true);
            }

            if(t.includes('ลบชิ้น')){
              btn.dataset.hardBound = '1';
              btn.addEventListener('click', function(e){ e.preventDefault(); deleteSelected(); }, true);
            }

            if(t.includes('นำไปข้างหน้า')){
              btn.dataset.hardBound = '1';
              btn.addEventListener('click', function(e){ e.preventDefault(); bringFront(); }, true);
            }

            if(t.includes('นำไปข้างหลัง')){
              btn.dataset.hardBound = '1';
              btn.addEventListener('click', function(e){ e.preventDefault(); sendBack(); }, true);
            }

            if(t === '-' || t === '−'){
              btn.dataset.hardBound = '1';
              btn.addEventListener('click', function(e){ e.preventDefault(); scaleSelected(0.9); }, true);
            }

            if(t === '+'){
              btn.dataset.hardBound = '1';
              btn.addEventListener('click', function(e){ e.preventDefault(); scaleSelected(1.1); }, true);
            }

            if(t.includes('หมุนซ้าย')){
              btn.dataset.hardBound = '1';
              btn.addEventListener('click', function(e){ e.preventDefault(); rotateSelected(-8); }, true);
            }

            if(t.includes('หมุนขวา')){
              btn.dataset.hardBound = '1';
              btn.addEventListener('click', function(e){ e.preventDefault(); rotateSelected(8); }, true);
            }
          });
        }

        bindToolButtonsHard();
        setInterval(bindToolButtonsHard, 800);

        function loadStartImageFromQuery(){
          try{
            const params = new URLSearchParams(location.search);
            const startImage = params.get('start_image');
            if(!startImage) return;

            loadImg(startImage, img=>{
              bg = img;
              if(typeof bgSrc !== 'undefined'){
                bgSrc = startImage;
              }
              if(typeof status === 'function'){
                status('เปิดรูปที่สร้างแล้วมาแก้ต่อ');
              }
              draw();
            });
          }catch(e){}
        }

        renderAssets();
        loadStartImageFromQuery();
        draw();
      </script>
    </body></html>
    """
    return html

