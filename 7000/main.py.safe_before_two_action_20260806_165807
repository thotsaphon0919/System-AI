*/
(function(){
  if(location.pathname !== "/") return;
  if(window.__CREATIVE_ROOM_FINAL_PATCH__) return;
  window.__CREATIVE_ROOM_FINAL_PATCH__ = true;

  function toast(msg){
    let t = document.getElementById("__crToast");
    if(!t){
      t = document.createElement("div");
      t.id = "__crToast";
      t.style.cssText = "position:fixed;top:12px;left:50%;transform:translateX(-50%);z-index:999999;background:#160800;color:white;border:1px solid rgba(255,174,25,.65);border-radius:999px;padding:10px 14px;font:14px system-ui;font-weight:800;display:none";
      document.body.appendChild(t);
    }
    t.textContent = msg;
    t.style.display = "block";
