from pathlib import Path as _CorePath
import json as _CoreJson
import time as _CoreTime
import uuid as _CoreUuid
from fastapi import Form as _CoreForm, UploadFile as _CoreUploadFile, File as _CoreFile
from fastapi.responses import HTMLResponse as _CoreHTMLResponse, RedirectResponse as _CoreRedirectResponse, FileResponse as _CoreFileResponse

_CORE_DIR = _CorePath("data/infini_ai_core")
_CORE_DIR.mkdir(parents=True, exist_ok=True)

_CORE_UPLOADS = _CORE_DIR / "uploads"
_CORE_UPLOADS.mkdir(parents=True, exist_ok=True)

_CORE_DB = _CORE_DIR / "knowledge.json"
_CORE_LAST = _CORE_DIR / "last_ability.json"


def _core_load(path, default):
    try:
        if path.exists():
            return _CoreJson.loads(path.read_text(encoding="utf-8"))
    except Exception:
        pass
    return default


def _core_save(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(_CoreJson.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")


def _core_db():
    data = _core_load(_CORE_DB, {"items": []})
    if "items" not in data:
        data = {"items": []}
    _core_save(_CORE_DB, data)
    return data


def _core_esc(x):
    return str(x or "").replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace('"', "&quot;")


def _core_ext(filename):
    ext = _CorePath(filename or "file").suffix.lower()
    if ext not in {".jpg", ".jpeg", ".png", ".webp", ".gif", ".txt", ".csv", ".json"}:
        ext = ".txt"
    return ext


async def _core_save_file(file, section):
    if not file:
        return None

    raw = await file.read()
    if not raw:
        return None

    if len(raw) > 30 * 1024 * 1024:
        return None

    ext = _core_ext(file.filename)
    stored = section + "_" + _CoreUuid.uuid4().hex + ext
    out = _CORE_UPLOADS / stored
    out.write_bytes(raw)

    text = ""
    if ext in {".txt", ".csv", ".json"}:
        text = raw.decode("utf-8", errors="ignore")

    return {
        "name": file.filename or stored,
        "stored": stored,
        "url": "/ai-core-file/" + stored,
        "ext": ext,
        "text": text,
        "section": section,
    }


def _core_items(section):
    return [x for x in _core_db().get("items", []) if x.get("section") == section]


def _core_shop_images():
    imgs = []
    for it in _core_items("shop_ai"):
        f = it.get("file") or {}
        if f.get("ext") in {".jpg", ".jpeg", ".png", ".webp", ".gif"} and f.get("url"):
            imgs.append({
                "title": it.get("title") or f.get("name") or "รูปจากห้องความรู้",
                "category": it.get("category") or "",
                "trigger": it.get("trigger") or "",
                "url": f.get("url"),
                "ext": f.get("ext"),
                "name": f.get("name"),
            })
    return imgs


def _core_render_items(section):
    items = _core_items(section)
    if not items:
        return '<p class="muted">ยังไม่มีข้อมูลในส่วนนี้</p>'

    html = []
    for it in items[::-1]:
        f = it.get("file") or {}
        file_html = ""

        if f.get("url"):
            if f.get("ext") in {".jpg", ".jpeg", ".png", ".webp", ".gif"}:
                file_html = '<img class="thumb" src="' + _core_esc(f.get("url")) + '">'
            else:
                file_html = '<a class="link" href="' + _core_esc(f.get("url")) + '">ไฟล์: ' + _core_esc(f.get("name")) + '</a>'

        html.append(
            '<div class="item">'
            '<div class="tag">' + _core_esc(it.get("category") or "-") + '</div>'
            '<h3>' + _core_esc(it.get("title") or "ไม่มีชื่อ") + '</h3>'
            '<p><b>Trigger:</b> ' + _core_esc(it.get("trigger") or "-") + '</p>'
            '<p>' + _core_esc(it.get("content") or "") + '</p>'
            + file_html +
            '</div>'
        )

    return "\n".join(html)


