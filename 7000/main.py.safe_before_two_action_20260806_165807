  <button class="btn" id="backBtn">กลับ</button>
</div>

<input id="pageFiles" type="file" accept="image/*,video/*" multiple style="display:none">

<div class="back" id="back"></div>
<div class="drawer" id="drawer">
  <div class="inner">
    <h2 id="drawerTitle">ตั้งค่า</h2>
    <div class="small" id="meta">ใส่ข้อมูลทั้งหมดในเฟืองนี้</div>
    <div class="preview" id="preview">ยังไม่มีสื่อ</div>

    <div class="field"><label>ชื่อ</label><input id="fTitle"></div>
    <div class="field"><label>คำสั้นใต้ชื่อ</label><input id="fSubtitle"></div>
    <div class="field"><label>รายละเอียด</label><textarea id="fDetail" rows="4"></textarea></div>
    <div class="field"><label>ลิงก์ปลายทางสุดท้าย</label><input id="fLink" placeholder="https://... หรือ /show/รหัสหน้า"></div>
    <div class="field"><label>การเผยแพร่</label><select id="fPublish"><option value="private">ส่วนตัว</option><option value="public">เผยแพร่</option><option value="draft">ร่าง</option></select></div>
