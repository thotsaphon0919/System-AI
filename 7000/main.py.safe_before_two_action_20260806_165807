        e.stopImmediatePropagation();

        location.href = "/subpages/" + pg.id;
        return false;
      }, true);
    });

    toast("พร้อมแล้ว");
  }

  setTimeout(()=>bind().catch(e=>{
    console.error(e);
    toast("ผูกเฟืองไม่สำเร็จ");
  }), 800);
})();
</script>

