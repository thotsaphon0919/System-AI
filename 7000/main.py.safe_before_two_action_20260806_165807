@app.post("/zone/private/header-upload")
async def private_zone_header_upload(file: _PVUploadFile = _PVFile(...)):
    _pv_init()
    ext = _PVPath(file.filename or "header.jpg").suffix.lower()
    if ext not in {".jpg", ".jpeg", ".png", ".webp"}:
        return _PVRedirectResponse("/zone/private", status_code=303)

    raw = await file.read()
    if not raw or len(raw) > 15 * 1024 * 1024:
        return _PVRedirectResponse("/zone/private", status_code=303)

    # ลบ header เก่า เพื่อให้เหลือรูปเดียวเป็นหัวข้อปัจจุบัน
    for old in _PV_HEADER_DIR.glob("header.*"):
        try:
            old.unlink()
        except Exception:
            pass

    out = _PV_HEADER_DIR / f"header{ext}"
    out.write_bytes(raw)
    return _PVRedirectResponse("/zone/private", status_code=303)

@app.get("/zone/private/header-image")
def private_zone_header_image():
    name = _pv_latest_header()
    if not name:
        return _PVResponse(status_code=404)
    target = _PV_HEADER_DIR / name
    if target.exists():
        return _PVFileResponse(target, headers={"Cache-Control":"no-store, no-cache, must-revalidate, max-age=0"})
    return _PVResponse(status_code=404)

