def _az_detail_zone_items(zone_key: str):
    """อ่านแผ่นจาก detail_swipe_7000.json ตามโซนที่ผู้ใช้เลือก"""
    import json as _json
    from pathlib import Path as _Path
    from urllib.parse import quote as _quote

    zone_numbers = {
        "private": "1",
        "office": "2",
        "shop": "3",
        "portfolio": "4",
    }

    wanted_zone = zone_numbers.get(zone_key)
    if not wanted_zone:
        return []

    db_path = _Path("data/detail_swipe_7000.json")
    if not db_path.exists():
        return []

    try:
        detail_data = _json.loads(
            db_path.read_text(encoding="utf-8")
        )
    except Exception:
        return []

    results = []
    seen = set()

    def walk(value):
        if isinstance(value, dict):
            page_no = str(value.get("no") or "").strip()
            page_zone = str(value.get("zone") or "").strip()

            if (
                page_no
                and page_zone == wanted_zone
                and page_no not in seen
            ):
                seen.add(page_no)

                media = str(
                    value.get("media_url")
                    or value.get("image")
                    or value.get("thumbnail_url")
                    or ""
                ).strip()

                # แปลง URL localhost ให้เป็น path ภายในเว็บ
                for prefix in (
                    "http://127.0.0.1:7000",
                    "http://localhost:7000",
                ):
                    if media.startswith(prefix):
                        media = media[len(prefix):]

                # ถ้าเป็นวิดีโอ ให้ใช้กล่อง INFINI แทนภาพแตก
                if str(value.get("media_type") or "").lower() == "video":
                    media = ""

                title = str(
                    value.get("title")
                    or value.get("name")
                    or f"no.{page_no}"
                ).strip()

                results.append({
                    "title": title,
                    "image": media,
                    "url": "/detail-page/" + _quote(page_no, safe="."),
                })

            for child in value.values():
                walk(child)

        elif isinstance(value, list):
            for child in value:
                walk(child)

    walk(detail_data)
    return results


