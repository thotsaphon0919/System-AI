<body>
<div class="toast" id="toast"></div>

<div class="app">
  <div class="top">
    <div class="brand">
      <div class="logo">∞</div>
      <div>
        <h1>INFINI SHOW PAGES</h1>
        <div class="sub" id="modeText">ทุกช่อง = หน้าโชว์ของย่อย</div>
      </div>
    </div>
