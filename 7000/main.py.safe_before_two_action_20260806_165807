@app.post("/ai-library/upload")
async def ai_library_upload(
    kind: str = _LSBForm("product"),
    title: str = _LSBForm(""),
    file: _LSBUploadFile = _LSBFile(None),
):
    if kind not in {"product", "scene", "generated"}:
        kind = "product"

    saved = await _lsb_save_upload(file, kind)
    if saved:
        if title.strip():
            saved["title"] = title.strip()
        data = _lsb_load()
        data.setdefault("items", []).append(saved)
        _lsb_save(data)

    return _LSBRedirectResponse("/ai-library", status_code=303)


@app.post("/ai-library/rename")
def ai_library_rename(
    id: str = _LSBForm(""),
    title: str = _LSBForm(""),
):
    data = _lsb_load()
    for it in data.get("items", []):
        if it.get("id") == id and title.strip():
            it["title"] = title.strip()
    _lsb_save(data)
    return _LSBRedirectResponse("/ai-library", status_code=303)


@app.post("/ai-library/delete")
def ai_library_delete(id: str = _LSBForm("")):
    data = _lsb_load()
    keep = []
    deleted = None

    for it in data.get("items", []):
        if it.get("id") == id:
            deleted = it
        else:
            keep.append(it)

    if deleted:
        try:
            path = _LSB_UPLOADS / _LSBPath(deleted.get("stored") or "").name
            if path.exists():
                path.unlink()
        except Exception:
            pass

    data["items"] = keep
    _lsb_save(data)
    return _LSBRedirectResponse("/ai-library", status_code=303)


@app.post("/scene-builder/save")
def scene_builder_save(
    title: str = _LSBForm("รูปที่สร้างแล้ว"),
    image_data: str = _LSBForm(""),
):
    try:
        if "," in image_data:
            image_data = image_data.split(",", 1)[1]

        raw = _LSBBase64.b64decode(image_data)
        if not raw:
            return _LSBRedirectResponse("/scene-builder", status_code=303)

        stored = "generated_" + _LSBUuid.uuid4().hex + ".png"
        out = _LSB_UPLOADS / stored
        out.write_bytes(raw)

        item = {
            "id": "img_" + _LSBUuid.uuid4().hex[:12],
            "kind": "generated",
            "title": title.strip() or "รูปที่สร้างแล้ว",
            "stored": stored,
            "url": "/ai-library/file/" + stored,
            "created_at": int(_LSBTime.time()),
        }

        data = _lsb_load()
        data.setdefault("items", []).append(item)
        _lsb_save(data)

    except Exception:
        pass

    return _LSBRedirectResponse("/scene-builder", status_code=303)


