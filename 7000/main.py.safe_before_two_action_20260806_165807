<script>
let state=null;
let topState=null;
let longTimer=null;
let longPressed=false;

const $=id=>document.getElementById(id);

function toast(msg){
  const t=$("toast");
  t.textContent=msg;
  t.style.display="block";
  setTimeout(()=>t.style.display="none",1400);
}

async function api(url,opt={}){
  const res=await fetch(url,{headers:{"Content-Type":"application/json",...(opt.headers||{})},...opt});
  if(!res.ok) throw new Error(await res.text());
  return await res.json();
}

function mediaHtml(url,type,emptyClass){
  if(!url) return `<div class="${emptyClass}">+</div>`;
  if(type==="video" || url.toLowerCase().match(/\.(mp4|webm|mov)$/)){
    return `<video src="${url}" muted autoplay loop playsinline></video>`;
  }
  return `<img src="${url}">`;
}

function pickFile(uploadUrl){
  const input=document.createElement("input");
  input.type="file";
  input.accept="image/*,video/*";
  input.onchange=async()=>{
    const f=input.files[0];
    if(!f) return;

    const fd=new FormData();
    fd.append("file",f);

    toast("กำลังอัปโหลด...");
    const res=await fetch(uploadUrl,{method:"POST",body:fd});
    if(!res.ok){
      toast("อัปโหลดไม่สำเร็จ");
      return;
    }

    toast("อัปโหลดแล้ว");
    setTimeout(()=>location.reload(),500);
  };
  input.click();
}

function bindLongPress(el,onLong,onTap){
  el.addEventListener("pointerdown",()=>{
    longPressed=false;
    clearTimeout(longTimer);
    longTimer=setTimeout(()=>{
      longPressed=true;
      onLong();
    },280);
  });

  el.addEventListener("pointerup",()=>{
    clearTimeout(longTimer);
    setTimeout(()=>{
      if(!longPressed && onTap) onTap();
    },10);
  });

  el.addEventListener("pointerleave",()=>{
    clearTimeout(longTimer);
  });

  el.addEventListener("pointercancel",()=>{
    clearTimeout(longTimer);
  });
}

function renderHero(){
  const box=$("heroBox");
  const url=topState.media_url||"";
  const type=topState.media_type||"";

  box.innerHTML=mediaHtml(url,type,"empty");

  bindLongPress(
    box,
    ()=>pickFile("/api/simple/top/upload"),
    ()=>toast("กดค้างเพื่ออัปโหลดสื่อบนสุด")
  );
}


function pageObj(){
  try{ if(typeof page !== "undefined" && page) return page; }catch(e){}
  try{ if(typeof room !== "undefined" && room) return room; }catch(e){}
  try{ if(typeof currentPage !== "undefined" && currentPage) return currentPage; }catch(e){}
  return {};
}

function val(obj, keys){
  for(const k of keys){
    if(obj && obj[k] !== undefined && obj[k] !== null && String(obj[k]).trim() !== ""){
      return String(obj[k]).trim();
    }
  }
  return "";
}

function pageMode(){
  const p = pageObj();
  const raw = val(p, ["page_type","type","mode","kind","category"]);
  return raw.toLowerCase();
}

function isTerminalPage(){
  const m = pageMode();
  return (
    m.includes("auction") ||
    m.includes("ประมูล") ||
    m.includes("sell") ||
    m.includes("sale") ||
    m.includes("product") ||
    m.includes("สินค้า") ||
    m.includes("จำหน่าย")
  );
}

function escHtml(x){
  return String(x || "").replace(/[&<>"']/g, m => ({
    "&":"&amp;",
    "<":"&lt;",
    ">":"&gt;",
    '"':"&quot;",
    "'":"&#039;"
  }[m]));
}

function renderPageInfo(){
  const box = $("pageInfo");
  if(!box) return;

  const p = pageObj();
  const terminal = isTerminalPage();

  const title = val(p, ["title","name"]);
  const desc = val(p, ["note","description","detail","details"]);
  const link = val(p, ["link_url","link","url","website"]);
  const price = val(p, ["price","start_price","current_price"]);
  const phone = val(p, ["phone","tel","mobile"]);
  const line = val(p, ["line","line_id"]);
  const fb = val(p, ["facebook","fb"]);

  const rows = [
    ["ราคา", price],
    ["เบอร์โทร", phone],
    ["Line", line],
    ["Facebook", fb],
    ["เว็บไซต์", link],
  ].filter(x => x[1]);

  if(!title && !desc && rows.length === 0){
    box.innerHTML = "";
    box.style.display = "none";
    return;
  }

  box.style.display = "";

  let rowsHtml = "";
  if(rows.length){
    rowsHtml = '<div class="infoRows">' + rows.map(r =>
      '<div class="infoCell"><div class="infoLabel">' + escHtml(r[0]) + '</div><div class="infoValue">' + escHtml(r[1]) + '</div></div>'
    ).join("") + '</div>';
  }

  box.innerHTML =
    '<section class="infoBox">' +
      '<div class="infoKicker">' + (terminal ? 'ข้อมูลสินค้า' : 'ข้อมูลของหน้านี้') + '</div>' +
      (title ? '<div class="infoTitle">' + escHtml(title) + '</div>' : '') +
      (desc ? '<div class="infoDesc">' + escHtml(desc) + '</div>' : '') +
      rowsHtml +
    '</section>';
}

function renderCards(){
  const grid=$("grid");
  grid.innerHTML="";

  const pages=(state.pages||[]);

  pages.forEach(pg=>{
    const url=pg.cover_url||pg.media_url||"";
    const type=pg.cover_type||pg.media_type||"";

    const card=document.createElement("div");
    card.className="card";
    card.innerHTML=`
      <div class="cardMedia">${mediaHtml(url,type,"cardEmpty")}</div>
    `;

    bindLongPress(
      card,
      ()=>pickFile("/api/pages/"+pg.id+"/upload"),
      ()=>location.href="/subpages/"+pg.id
    );

    grid.appendChild(card);
  });
}

async function load(){
  state=await api("/api/state");
  topState=await api("/api/simple/top");
  renderHero();
  renderCards();
}

$("plusBtn").onclick=async()=>{
  toast("กำลังเพิ่มช่อง...");
  const pg=await api("/api/simple/add-card",{method:"POST",body:"{}"});
  toast("เพิ่มช่องแล้ว");
  setTimeout(()=>location.reload(),400);
};

load().catch(e=>{console.error(e);toast("โหลดหน้าไม่สำเร็จ")});
</script>
</body>
</html>
"""

