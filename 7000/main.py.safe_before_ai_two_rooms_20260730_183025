@app.post("/zone-board/{zone}/scene-upload")
async def zone_board_scene_upload(zone: str, file: _ZUploadFile = _ZFile(...)):
    if zone not in _ZONES2:
        return _ZRedirectResponse("/zone-board", status_code=303)
    _z_init()
    ext = _ZPath(file.filename or "scene.jpg").suffix.lower()
    if ext not in {".jpg", ".jpeg", ".png", ".webp"}:
        return _ZRedirectResponse(f"/zone-board/{zone}", status_code=303)
    raw = await file.read()
    if not raw or len(raw) > 15 * 1024 * 1024:
        return _ZRedirectResponse(f"/zone-board/{zone}", status_code=303)
    out = _ZSCENES / f"{zone}{ext}"
    out.write_bytes(raw)
    data = _z_load()
    data["zones"][zone]["scene"] = out.name
    _z_save(data)
    return _ZRedirectResponse(f"/zone-board/{zone}", status_code=303)

@app.get("/zone-board-scene/{zone}")
def zone_board_scene(zone: str):
    if zone not in _ZONES2:
        return _ZResponse(status_code=404)
    data = _z_load()
    name = data["zones"][zone].get("scene") or ""
    target = _ZSCENES / name
    if name and target.exists():
        return _ZFileResponse(target, headers={"Cache-Control":"no-store, no-cache, must-revalidate, max-age=0"})
    return _ZResponse(status_code=404)

@app.post("/zone-board/{zone}/slot/{slot_no}")
async def zone_board_slot(zone: str, slot_no: int, title: str = _ZForm(""), url: str = _ZForm("")):
    if zone not in _ZONES2 or slot_no < 1 or slot_no > 12:
        return _ZRedirectResponse("/zone-board", status_code=303)
    data = _z_load()
    data["zones"][zone]["slots"][slot_no-1] = {
        "title": (title or f"ช่อง {slot_no}").strip()[:80],
        "url": (url or "").strip()[:500],
    }
    _z_save(data)
    return _ZRedirectResponse(f"/zone-board/{zone}", status_code=303)

