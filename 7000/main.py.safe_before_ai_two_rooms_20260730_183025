    data["design_system"] = {
        "theme": theme,
        "primary_color": primary_color,
        "accent_color": accent_color,
        "background": background,
        "corner_radius": corner_radius,
        "glass_effect": glass_effect,
        "shadow": shadow,
        "spacing": spacing,
