@app.post("/ai-design-system/upload")
async def ai_design_system_upload(
    files: _DSList[_DSUploadFile] = _DSFile(default=[]),
    kind: str = _DSForm("references"),
    role: str = _DSForm("mood reference"),
    label: str = _DSForm(""),
    note: str = _DSForm(""),
):
    data = _ds_load()
    key = "assets" if kind == "assets" else "references"
    data.setdefault("references", [])
    data.setdefault("assets", [])

    for f in files[:20]:
        url = await _ds_save_file(f)
        if url:
            data[key].append({
                "id": _DSUuid.uuid4().hex,
                "url": url,
                "role": role,
                "label": label,
                "note": note,
            })

    _ds_save(data)
    return _DSRedirectResponse("/ai-design-system", status_code=303)

@app.get("/ai-design-system/file/{name}")
def ai_design_system_file(name: str):
    target = _DS_UPLOADS / name
    if target.exists() and target.is_file():
        return _DSFileResponse(target, headers={"Cache-Control":"no-store, no-cache, must-revalidate, max-age=0"})
    return _DSResponse(status_code=404)

@app.get("/ai-design-system/json")
def ai_design_system_json():
    data = _ds_load()
    data["prompt_dna"] = _ds_prompt_text(data)
    return data

