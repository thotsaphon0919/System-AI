@app.post("/ai-design-system/save")
def ai_design_system_save(
    theme: str = _DSForm(""),
    font: str = _DSForm(""),
    primary_color: str = _DSForm(""),
    accent_color: str = _DSForm(""),
    background: str = _DSForm(""),
    corner_radius: str = _DSForm(""),
    glass_effect: str = _DSForm(""),
    shadow: str = _DSForm(""),
    spacing: str = _DSForm(""),
    header: str = _DSForm(""),
    content: str = _DSForm(""),
    bottom_nav: str = _DSForm(""),
    card_columns: str = _DSForm(""),
    gap: str = _DSForm(""),
    glow_level: str = _DSForm(""),
    feeling: str = _DSForm(""),
    luxury: str = _DSForm(""),
    future: str = _DSForm(""),
    line_weight: str = _DSForm(""),
    card_style: str = _DSForm(""),
    icon_style: str = _DSForm(""),
