def media_html(media: str, css_class: str = "media") -> str:
    if not media:
        return ""

    safe = html.escape(media, quote=True)
    suffix = Path(media).suffix.lower()

    if suffix in {".mp4", ".webm", ".mov", ".m4v"}:
        return f'<video class="{css_class}" src="{safe}" controls playsinline preload="metadata"></video>'

    return f'<img class="{css_class}" src="{safe}" alt="media">'


