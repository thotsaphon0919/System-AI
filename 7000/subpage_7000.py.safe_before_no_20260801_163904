DEFAULT_DATA: dict[str, Any] = {
    "pages": {
        "1": {
            "number": "1",
            "title": "no.1",
            "detail": "",
            "link": "",
            "media": "",
            "parent": "",
            "children": [],
        }
    }
}


def load_data() -> dict[str, Any]:
    if not DATA_FILE.exists():
        save_data(DEFAULT_DATA)
        return json.loads(json.dumps(DEFAULT_DATA))

    try:
        data = json.loads(DATA_FILE.read_text(encoding="utf-8"))
        if not isinstance(data, dict) or "pages" not in data:
            raise ValueError("invalid data")
        return data
    except Exception:
        broken = DATA_FILE.with_suffix(f".broken-{int(time.time())}.json")
        shutil.copy2(DATA_FILE, broken)
        save_data(DEFAULT_DATA)
        return json.loads(json.dumps(DEFAULT_DATA))


def save_data(data: dict[str, Any]) -> None:
    temp = DATA_FILE.with_suffix(".tmp")
    temp.write_text(
        json.dumps(data, ensure_ascii=False, indent=2),
        encoding="utf-8",
    )
    temp.replace(DATA_FILE)


def valid_number(number: str) -> bool:
    return bool(re.fullmatch(r"\d+(?:\.\d+)*", number))


def next_child_number(parent: str, children: list[str]) -> str:
    prefix = f"{parent}."
    used: list[int] = []

    for child in children:
        if child.startswith(prefix):
            tail = child[len(prefix):]
            if tail.isdigit():
                used.append(int(tail))

    next_index = max(used, default=0) + 1
    return f"{parent}.{next_index}"


