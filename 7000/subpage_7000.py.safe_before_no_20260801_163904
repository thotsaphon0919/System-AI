    @app.post("/subpages/{number}/save")
    async def save_page(
        number: str,
        title: str = Form(""),
        detail: str = Form(""),
        link: str = Form(""),
        media: UploadFile | None = File(None),
    ) -> RedirectResponse:
        if not valid_number(number):
            raise HTTPException(400, "เลขหน้าไม่ถูกต้อง")

        data = load_data()
        page = data["pages"].get(number)
        if not page:
            raise HTTPException(404, "ไม่พบหน้านี้")

        page["title"] = title.strip()
        page["detail"] = detail.strip()
        page["link"] = link.strip()

        if media and media.filename:
            suffix = Path(media.filename).suffix.lower()
            allowed = {
                ".jpg", ".jpeg", ".png", ".webp", ".gif",
                ".mp4", ".webm", ".mov", ".m4v",
            }
            if suffix not in allowed:
                raise HTTPException(
                    400,
                    "รองรับเฉพาะรูปและวิดีโอ",
                )

            safe_number = number.replace(".", "_")
            filename = f"{safe_number}_{int(time.time())}{suffix}"
            destination = UPLOAD_DIR / filename

            with destination.open("wb") as output:
                shutil.copyfileobj(media.file, output)

            old_media = page.get("media", "")
            if old_media.startswith("/subpage-media/"):
                old_path = UPLOAD_DIR / Path(old_media).name
                if old_path.exists():
                    old_path.unlink(missing_ok=True)

            page["media"] = f"/subpage-media/{filename}"

        save_data(data)
        return RedirectResponse(
            f"/subpages/{number}",
            status_code=303,
        )

    @app.post("/subpages/{number}/delete")
    async def delete_page(number: str) -> RedirectResponse:
        if number == "1":
            raise HTTPException(400, "ไม่สามารถลบหน้าหลักได้")

        data = load_data()
        page = data["pages"].get(number)
        if not page:
            raise HTTPException(404, "ไม่พบหน้านี้")

        if page.get("children"):
            raise HTTPException(
                400,
                "หน้านี้ยังมีหน้าย่อย ต้องลบหน้าย่อยก่อน",
            )

        media = page.get("media", "")
        if media.startswith("/subpage-media/"):
            media_path = UPLOAD_DIR / Path(media).name
            media_path.unlink(missing_ok=True)

        parent = page.get("parent", "")
        parent_page = data["pages"].get(parent)
        if parent_page:
            parent_page["children"] = [
                item
                for item in parent_page.get("children", [])
                if item != number
            ]

        del data["pages"][number]
        save_data(data)

        return RedirectResponse(
            f"/subpages/{parent or '1'}",
            status_code=303,
        )
