    @app.post("/subpages/{parent}/add-child")
    async def add_child(parent: str) -> RedirectResponse:
        if not valid_number(parent):
            raise HTTPException(400, "เลขหน้าไม่ถูกต้อง")

        data = load_data()
        parent_page = data["pages"].get(parent)
        if not parent_page:
            raise HTTPException(404, "ไม่พบหน้าต้นทาง")

        child_number = next_child_number(
            parent,
            parent_page.setdefault("children", []),
        )

        data["pages"][child_number] = {
            "number": child_number,
            "title": child_number,
            "detail": "",
            "link": "",
            "media": "",
            "parent": parent,
            "children": [],
        }
        parent_page["children"].append(child_number)
        save_data(data)

        return RedirectResponse(
            f"/subpages/{child_number}/edit",
            status_code=303,
        )

