  setTimeout(()=>t.classList.remove("show"),1600);
}

async function api(url,opt={}){
  const res=await fetch(url,{headers:{"Content-Type":"application/json",...(opt.headers||{})},...opt});
  if(!res.ok)throw new Error(await res.text());
  return await res.json();
}

async function load(){ st=await api("/api/id"); render(); }

function coverHtml(url,type){
  if(!url)return '<div class="plus">+</div>';
  if(type==="video")return `<div class="ownerMedia"><video src="${url}" muted autoplay loop playsinline></video></div>`;
  return `<div class="ownerMedia"><img src="${url}"></div>`;
}

function render(){
  $("coverBody").innerHTML=coverHtml(st.cover_url,st.cover_type);
  $("nameView").textContent=st.name||"INFINI ID";
  $("metaView").textContent=(st.username?("@"+st.username+" · "):"")+(st.infini_id||"INF-000001");
  $("apiView").textContent=st.api_key||"ยังไม่ได้ใส่";
  $("galleryCount").textContent=(st.gallery||[]).length+" ไฟล์";

  $("chatBox").innerHTML="";
  (st.chat||[]).slice(-30).forEach((m,i)=>{
    const d=document.createElement("div");
    d.className="msg "+(i%2?"me":"");
    d.textContent=m.text||"";
    $("chatBox").appendChild(d);
  });

  $("gallery").innerHTML="";
  (st.gallery||[]).slice(-9).forEach(g=>{
    const el=document.createElement("div");
    el.className="gitem";
    el.innerHTML=g.type==="video" ? `<video src="${g.url}" muted autoplay loop playsinline></video>` : `<img src="${g.url}">`;
    $("gallery").appendChild(el);
