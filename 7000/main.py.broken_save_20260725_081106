function useItem(pid,iid){
  const it=getItem(pid,iid);
  if(it.enabled===false){toast("ช่องนี้ปิดอยู่");return}
  if(it.link_url){location.href=it.link_url;return}
  if(it.media_url){openViewer(it);return}
  openItemGear(pid,iid);
}

