class RoomSlotPatch(BaseModel):
    title: Optional[str] = None
    note: Optional[str] = None
    link_url: Optional[str] = None

def ensure_room_page(page_id: str):
    st = load_state()
    pages = st.get("pages", [])
    page = next((p for p in pages if p.get("id") == page_id), None)
    if not page:
        page = {
            "id": page_id,
            "title": "",
            "cover_url": "",
            "cover_type": "",
            "items": [],
            "created_at": now(),
            "updated_at": now()
        }
        pages.append(page)

    page.setdefault("items", [])
    while len(page["items"]) < 6:
        n = len(page["items"]) + 1
        page["items"].append({
            "id": uid("sheet"),
            "title": f"no.{n}",
            "note": "",
            "media_url": "",
            "media_type": "",
            "link_url": "",
            "created_at": now(),
            "updated_at": now()
        })

    page["items"] = page["items"][:6]
    st["pages"] = pages
    save_state(st)
    return page

