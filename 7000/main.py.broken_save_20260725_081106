  $("drawer").classList.add("show");
}

function closeGear(){
  $("back").classList.remove("show");
  $("drawer").classList.remove("show");
}

async function saveGear(){
  st=await api("/api/id",{method:"PATCH",body:JSON.stringify({
    name:$("fName").value,
    username:$("fUsername").value,
    infini_id:$("fInfiniId").value,
    api_key:$("fApi").value,
    bio:$("fBio").value
  })});
  toast("บันทึกแล้ว");
  render();
}

async function uploadCover(){
  const f=$("coverFile").files[0];
  if(!f)return;
  const fd=new FormData();
  fd.append("file",f);
  const res=await fetch("/api/id/upload-cover",{method:"POST",body:fd});
  st=await res.json();
  toast("อัปโหลดรูป ID แล้ว");
  render();
}

async function uploadGallery(files){
  if(!files.length)return;
  const fd=new FormData();
  [...files].forEach(f=>fd.append("files",f));
  const res=await fetch("/api/id/gallery",{method:"POST",body:fd});
  st=await res.json();
  toast("เพิ่มเข้าคลังรูปแล้ว");
  render();
