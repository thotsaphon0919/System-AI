ID_STATE = DATA / "id_home.json"

def default_id_state():
    return {
        "name": "",
        "username": "",
        "infini_id": "INF-000001",
        "bio": "",
        "api_key": "",
        "cover_url": "",
        "cover_type": "",
        "gallery": [],
        "chat": []
    }

def load_id_state():
    if not ID_STATE.exists():
        return save_id_state(default_id_state())
    try:
        st = json.loads(ID_STATE.read_text(encoding="utf-8"))
    except Exception:
        st = default_id_state()
    d = default_id_state()
    d.update(st)
    return save_id_state(d)

def save_id_state(st):
    ID_STATE.write_text(json.dumps(st, ensure_ascii=False, indent=2), encoding="utf-8")
    return st

