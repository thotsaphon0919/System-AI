  for(const s of h.slots){const n={...s,img:null};if(s.src){try{n.img=await loadImg(s.src)}catch(e){}}slots.push(n)}
  selectedIndex=Math.min(selectedIndex,slots.length-1);draw();status('ย้อนกลับแล้ว')
}

function rr(x,y,w,h,r){r=Math.min(r,w/2,h/2);ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath()}
function drawCover(img,x,y,w,h){const sc=Math.max(w/img.width,h/img.height),dw=img.width*sc,dh=img.height*sc;ctx.drawImage(img,x+(w-dw)/2,y+(h-dh)/2,dw,dh)}
function drawSlot(s,i){
  ctx.save();rr(s.x,s.y,s.w,s.h,20);ctx.clip();ctx.fillStyle='rgba(0,0,0,.22)';ctx.fillRect(s.x,s.y,s.w,s.h);
  if(s.img){const base=s.fit==='cover'?Math.max(s.w/s.img.width,s.h/s.img.height):Math.min(s.w/s.img.width,s.h/s.img.height),dw=s.img.width*base*s.scale,dh=s.img.height*base*s.scale,cx=s.x+s.w/2+s.offsetX,cy=s.y+s.h/2+s.offsetY;ctx.drawImage(s.img,cx-dw/2,cy-dh/2,dw,dh)}
  ctx.restore();
  if(guides){ctx.save();rr(s.x,s.y,s.w,s.h,20);ctx.strokeStyle=i===selectedIndex?'#ff981f':'rgba(255,195,91,.72)';ctx.lineWidth=i===selectedIndex?6:3;ctx.setLineDash(i===selectedIndex?[]:[12,8]);ctx.stroke();ctx.setLineDash([]);ctx.fillStyle='rgba(0,0,0,.72)';ctx.fillRect(s.x+8,s.y+8,48,36);ctx.fillStyle='#ffc35b';ctx.font='bold 22px system-ui';ctx.fillText(String(i+1),s.x+23,s.y+34);ctx.restore()}
}
function draw(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  if(bg)drawCover(bg,0,0,canvas.width,canvas.height);else{const g=ctx.createLinearGradient(0,0,0,canvas.height);g.addColorStop(0,'#271207');g.addColorStop(1,'#050302');ctx.fillStyle=g;ctx.fillRect(0,0,canvas.width,canvas.height);ctx.fillStyle='#ff981f';ctx.font='bold 44px system-ui';ctx.textAlign='center';ctx.fillText('เลือกฉากก่อน',canvas.width/2,170);ctx.textAlign='start'}
  slots.forEach(drawSlot)
}
function point(ev){const r=canvas.getBoundingClientRect();return{x:(ev.clientX-r.left)*canvas.width/r.width,y:(ev.clientY-r.top)*canvas.height/r.height}}
function hit(x,y){for(let i=slots.length-1;i>=0;i--){const s=slots[i];if(x>=s.x&&x<=s.x+s.w&&y>=s.y&&y<=s.y+s.h)return i}return-1}
function clampSlot(s){s.x=Math.max(0,Math.min(canvas.width-s.w,s.x));s.y=Math.max(0,Math.min(canvas.height-s.h,s.y))}
canvas.onpointerdown=ev=>{const p=point(ev),i=hit(p.x,p.y);if(i<0){selectedIndex=-1;draw();return}selectedIndex=i;dragging=true;last=p;canvas.setPointerCapture(ev.pointerId);pushHistory();draw()}
canvas.onpointermove=ev=>{if(!dragging||selectedIndex<0)return;const p=point(ev),dx=p.x-last.x,dy=p.y-last.y,s=selected();if(dragMode==='slot'){s.x+=dx;s.y+=dy;clampSlot(s)}else{s.offsetX+=dx;s.offsetY+=dy}last=p;draw()}
canvas.onpointerup=()=>dragging=false;canvas.onpointercancel=()=>dragging=false;

function cleanData(){const old=guides;guides=false;draw();const data=canvas.toDataURL('image/png');guides=old;draw();return data}
function downloadPng(){const a=document.createElement('a');a.href=cleanData();a.download='infini-shop-scene.png';a.click();status('ดาวน์โหลด PNG แล้ว')}
