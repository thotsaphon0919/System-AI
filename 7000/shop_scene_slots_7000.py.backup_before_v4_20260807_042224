LIB_UPLOADS = LIB_DIR / "uploads"
LIB_DB = LIB_DIR / "library.json"
LIB_UPLOADS.mkdir(parents=True, exist_ok=True)

def _load_library() -> dict[str, Any]:
    try:
        if LIB_DB.exists():
            data = json.loads(LIB_DB.read_text(encoding="utf-8"))
            if isinstance(data, dict) and isinstance(data.get("items"), list):
                return data
    except Exception:
        pass
    return {"items": []}

def _save_library(data: dict[str, Any]) -> None:
    LIB_DIR.mkdir(parents=True, exist_ok=True)
    tmp = LIB_DB.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
    tmp.replace(LIB_DB)

def _decode_png(data_url: str) -> bytes:
    if not isinstance(data_url, str) or not data_url:
        raise ValueError("missing image data")
    payload = data_url.split(",", 1)[1] if "," in data_url else data_url
    raw = base64.b64decode(payload, validate=False)
    if not raw:
        raise ValueError("empty image")
    if len(raw) > 30 * 1024 * 1024:
        raise ValueError("image too large")
    return raw

