function zoomSelected(f){const s=selected();if(!s||!s.img)return;pushHistory();s.scale=Math.max(.1,Math.min(8,s.scale*f));draw()}
function resizeSlot(f){const s=selected();if(!s)return;pushHistory();const cx=s.x+s.w/2,cy=s.y+s.h/2;s.w=Math.max(70,Math.min(800,s.w*f));s.h=Math.max(70,Math.min(1000,s.h*f));s.x=cx-s.w/2;s.y=cy-s.h/2;clampSlot(s);draw()}
function setFit(f){const s=selected();if(!s)return;pushHistory();s.fit=f;s.scale=1;s.offsetX=0;s.offsetY=0;draw()}
function resetSelected(){const s=selected();if(!s)return;pushHistory();s.scale=1;s.offsetX=0;s.offsetY=0;s.fit='contain';draw()}
function deleteSelected(){if(selectedIndex<0)return;pushHistory();slots.splice(selectedIndex,1);selectedIndex=Math.min(selectedIndex,slots.length-1);draw()}
function clearAll(){pushHistory();bg=null;slots=[];selectedIndex=-1;draw();status('ล้างแล้ว')}
function toggleGuides(){guides=!guides;document.getElementById('guideBtn').textContent='เส้นช่อง: '+(guides?'เปิด':'ปิด');document.getElementById('guideBtn').classList.toggle('active',guides);draw()}

function pushHistory(){history.push({bgSrc:bg?bg.src:null,slots:slots.map(s=>({x:s.x,y:s.y,w:s.w,h:s.h,src:s.src,scale:s.scale,offsetX:s.offsetX,offsetY:s.offsetY,fit:s.fit}))});if(history.length>18)history.shift()}
