function addSlot(){pushHistory();slots.push(newSlot(300,520,300,320));selectedIndex=slots.length-1;draw();status('เพิ่มช่องใหม่แล้ว')}
function selected(){return slots[selectedIndex]||null}
function assignToSlot(img,src){
