function fileToImage(file,cb){
  if(!file)return;
  const r=new FileReader();
  r.onload=async()=>{try{cb(await loadImg(r.result),r.result)}catch(e){status('อ่านไฟล์ไม่ได้')}};
  r.readAsDataURL(file);
}
document.getElementById('sceneFile').onchange=e=>{fileToImage(e.target.files[0],img=>{pushHistory();bg=img;draw();status('ใส่ฉากจากเครื่องแล้ว')});e.target.value=''};
