def install_shop_scene_slots_7000(app) -> None:
    if getattr(app.state, "_infini_shop_scene_slots_v1", False):
        return
    app.state._infini_shop_scene_slots_v1 = True

    async def page() -> HTMLResponse:
        return HTMLResponse(_html(_load_library().get("items", [])))

    async def save(request: Request) -> JSONResponse:
        try:
            payload = await request.json()
            title = str(payload.get("title") or "ร้านที่จัดจาก Shop Scene Slots").strip()
            raw = _decode_png(str(payload.get("image_data") or ""))
            stored = "generated_shop_slots_" + uuid.uuid4().hex + ".png"
            (LIB_UPLOADS / stored).write_bytes(raw)
            item = {
                "id": "img_" + uuid.uuid4().hex[:12],
                "kind": "generated",
                "title": title or "ร้านที่จัดจาก Shop Scene Slots",
                "stored": stored,
                "url": "/ai-library/file/" + stored,
                "created_at": int(time.time()),
                "source": MODULE_NAME,
            }
            data = _load_library()
            data.setdefault("items", []).append(item)
            _save_library(data)
            return JSONResponse({"ok": True, "item": item})
        except Exception as exc:
            return JSONResponse({"ok": False, "error": str(exc)}, status_code=400)

    app.add_api_route("/shop-scene-builder", page, methods=["GET"], response_class=HTMLResponse, name="shop_scene_slots_page_v1")
    app.add_api_route("/shop-scene-builder/save", save, methods=["POST"], response_class=JSONResponse, name="shop_scene_slots_save_v1")
