    if not raw:
        return None
    ext = _sc_ext(file.filename)
    name = f"scene_{_SCUuid.uuid4().hex}{ext}"
    (_SC_UPLOADS / name).write_bytes(raw)
    return {
        "id": _SCUuid.uuid4().hex,
        "name": file.filename or name,
        "url": f"/ai-scene-composer/file/{name}"
    }

async def _sc_save_asset_cutout(file, role):
    raw = await file.read()
    if not raw:
        return None

    try:
        from PIL import Image
        import io, math

        img = Image.open(io.BytesIO(raw)).convert("RGBA")
        w, h = img.size

        max_side = 1600
        if max(w, h) > max_side:
            ratio = max_side / max(w, h)
            img = img.resize((int(w * ratio), int(h * ratio)))
            w, h = img.size

        px = img.load()
        corners = [px[0,0], px[w-1,0], px[0,h-1], px[w-1,h-1]]
        bg = tuple(sum(c[i] for c in corners) // 4 for i in range(3))

        threshold = 58
        soft = 34

        out = Image.new("RGBA", (w, h), (0,0,0,0))
        opx = out.load()

        for y in range(h):
            for x in range(w):
                r,g,b,a = px[x,y]
                d = math.sqrt((r-bg[0])**2 + (g-bg[1])**2 + (b-bg[2])**2)
                if d < threshold:
                    na = 0
                elif d < threshold + soft:
                    na = int(255 * ((d - threshold) / soft))
                else:
                    na = a
                opx[x,y] = (r,g,b,na)

        name = f"asset_cutout_{_SCUuid.uuid4().hex}.png"
        out.save(_SC_UPLOADS / name, "PNG")
        cutout = True

    except Exception:
        ext = _sc_ext(file.filename)
        name = f"asset_{_SCUuid.uuid4().hex}{ext}"
        (_SC_UPLOADS / name).write_bytes(raw)
        cutout = False

    x, y, scale, angle, z = _sc_auto_place(role)

    return {
        "id": _SCUuid.uuid4().hex,
        "name": file.filename or name,
        "url": f"/ai-scene-composer/file/{name}",
        "role": role,
        "x": x,
        "y": y,
        "scale": scale,
        "angle": angle,
        "z": z,
        "cutout": cutout
    }

def _sc_auto_place(role):
    rules = {
