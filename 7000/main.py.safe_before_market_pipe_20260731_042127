    "สั่ง": ["สั่ง", "ขอ", "เอา", "อยากได้", "ต้องการ"],
    "กาแฟ": ["กาแฟ", "เครื่องดื่ม", "เมนูกาแฟ", "เมนูน้ำ"],
    "ห้องความรู้กลาง": ["ห้องความรู้กลาง", "ห้องความรู้", "ความรู้กลาง", "ความรู้ส่วนกลาง", "knowledge master", "ai-knowledge-master"],
    "scene composer": ["scene composer", "ai-scene-composer", "จัดร้าน", "วางของ", "วางเข้าฉาก", "อัปโหลดฉาก"],
    "design system": ["design system", "visual dna", "dna", "ดีไซน์", "ดีเอ็นเอภาพ", "ai-design-system"],
}

def _infini_expand_query(text: str) -> str:
    t = (text or "").strip()
    expanded = [t]

    low = t.lower()
    for main, words in _INFINI_SYNONYMS.items():
        if any(w.lower() in low for w in words):
            expanded.append(main)
            expanded.extend(words)

    # normalize คำสะกดที่ชอบต่างกัน
    expanded.append(low.replace("คาปูชิโน่", "คาปูชิโน"))
    expanded.append(low.replace("อเมริกาโน่", "อเมริกาโน"))

    return " ".join([x for x in expanded if x])

def _infini_detect_intent(text: str) -> str:
    t = (text or "").lower()

    if any(w in t for w in ["สั่ง", "ขอ", "เอา", "อยากได้", "ต้องการ"]):
        return "order"

    if any(w in t for w in ["ราคา", "เท่าไหร่", "กี่บาท", "บาท"]):
        return "price"

    if any(w in t for w in ["หวาน", "น้ำตาล", "เปอร์เซ็นต์"]):
        return "sweetness"

    if any(w in t for w in ["คืออะไร", "คือ", "หน้าไหน", "อยู่หน้าอะไร", "ใช้อะไร"]):
        return "ask_info"

    return "general"

