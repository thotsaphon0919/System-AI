      uploadTop();
    });

    box.querySelector(".crTopUpload").addEventListener("click",e=>{
      e.preventDefault();
      e.stopPropagation();
      uploadTop();
    });
  }

  function findCards(){
    const gears = Array.from(document.querySelectorAll(".gear,button.gear,[class*='gear']"))
      .filter(g => !g.closest("#crTop") && !g.closest(".drawer") && !g.closest("[id^='__']"));

    const cards = [];
    gears.forEach(g=>{
      let el = g.parentElement;
      while(el && el !== document.body){
        const r = el.getBoundingClientRect();
        if(r.width > 90 && r.height > 90){
          if(!cards.includes(el)) cards.push(el);
          break;
