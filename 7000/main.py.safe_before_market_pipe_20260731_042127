    const pages = st.pages || [];

    setTimeout(()=>{
      const cards = findCards();

      cards.forEach((card,idx)=>{
        const pg = pages[idx];
        if(!pg || !pg.id) return;

        const gear = card.querySelector(".gear,button.gear,[class*='gear']");
