# === OFFLINE_PRODUCT_CUTOUT_PATCH_V1 ===
async def _oc_save_product_cutout(file):
    """
    Offline cutout แบบง่าย:
    - ใช้สีมุมซ้ายบนเป็นสีพื้นหลัง
    - ลบสีที่ใกล้เคียงให้โปร่งใส
    - เหมาะกับสินค้าพื้นหลังเรียบ เช่น ขาว ดำ ครีม เทา
    - ถ้าตัดไม่ได้ จะ fallback เป็นรูปเดิม
    """
    if not file:
        return None

    raw = await file.read()
    if not raw:
        return None
    if len(raw) > 25 * 1024 * 1024:
        return None

    try:
        from PIL import Image
        import io, math

        img = Image.open(io.BytesIO(raw)).convert("RGBA")
        w, h = img.size

        # ลดขนาดถ้าใหญ่เกิน เพื่อไม่ให้ Termux หนัก
        max_side = 1600
        if max(w, h) > max_side:
            ratio = max_side / max(w, h)
            img = img.resize((int(w * ratio), int(h * ratio)))
            w, h = img.size

        px = img.load()

        # เก็บสีพื้นหลังจาก 4 มุม แล้วเลือกค่าเฉลี่ย
        corners = [
            px[0, 0],
            px[w - 1, 0],
            px[0, h - 1],
            px[w - 1, h - 1],
        ]
        bg = tuple(sum(c[i] for c in corners) // len(corners) for i in range(3))

        threshold = 58
        soft = 34

        new = Image.new("RGBA", (w, h), (0, 0, 0, 0))
        out = new.load()

        for y in range(h):
            for x in range(w):
                r, g, b, a = px[x, y]
                d = math.sqrt((r-bg[0])**2 + (g-bg[1])**2 + (b-bg[2])**2)

                if d < threshold:
                    na = 0
                elif d < threshold + soft:
                    na = int(255 * ((d - threshold) / soft))
                else:
                    na = a

                out[x, y] = (r, g, b, na)

        name = f"product_cutout_{_OCUuid.uuid4().hex}.png"
        out_path = _OC_UPLOADS / name
        new.save(out_path, "PNG")

        return {
            "id": _OCUuid.uuid4().hex,
            "name": (file.filename or name) + " / cutout",
            "url": f"/ai-offline-composer/file/{name}",
            "kind": "product",
            "cutout": True
        }

    except Exception as e:
        # fallback: ถ้าตัดไม่ได้ ใช้รูปเดิม
        ext = _oc_ext(file.filename)
        name = f"product_{_OCUuid.uuid4().hex}{ext}"
        out_path = _OC_UPLOADS / name
        out_path.write_bytes(raw)
        return {
            "id": _OCUuid.uuid4().hex,
            "name": file.filename or name,
            "url": f"/ai-offline-composer/file/{name}",
            "kind": "product",
            "cutout": False,
            "error": str(e)
        }

