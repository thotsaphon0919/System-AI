def _ks_ext(filename):
    ext = _KSPath(filename or "file.jpg").suffix.lower()
    if ext not in {".jpg", ".jpeg", ".png", ".webp", ".gif"}:
        ext = ".jpg"
    return ext

async def _ks_save_file(file):
    if not file:
        return ""
    raw = await file.read()
    if not raw:
        return ""
    if len(raw) > 25 * 1024 * 1024:
        return ""
    ext = _ks_ext(file.filename)
    name = f"{_KSUuid.uuid4().hex}{ext}"
    out = _KS_UPLOADS / name
    out.write_bytes(raw)
    return f"/ai-knowledge-studio/file/{name}"

